            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('quantity=100 averageCost=2', function () {",
                  "  pm.expect(body.item.quantity).to.eql('100');",
                  "  pm.expect(body.item.averageCost).to.eql('2');",
