{
  "info": {
    "name": "Karayeban - گدام و اجناس",
    "description": "کالکشن تست ماژول Warehouse/Inventory کارایبان: لاگین، گدام‌ها، دسته‌بندی‌ها، کالاها (شامل ساخت با موجودی افتتاحیه)، و تراکنش‌های خرید/فروش/مصرف/اصلاح. هر درخواست بعد از اجرا id لازم را خودش در متغیرهای کالکشن ذخیره می‌کند — کافی است کل کالکشن را با Collection Runner از بالا به پایین اجرا کنید.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "identifier", "value": "adminmilicenter20" },
    { "key": "password", "value": "almas@12345" },
    { "key": "token", "value": "" },
    { "key": "currencyId", "value": "e9508cc0-ccd4-4258-bf6c-70b52faa0266", "description": "AFN — از قبل باید برای بازار فعال باشد" },
    { "key": "accountId", "value": "f07a4005-dba2-4a1d-ac3a-2f78648b7917", "description": "حساب/بانکی که پول ازش کم/زیاد می‌شود؛ باید هم‌ارز با currencyId باشد" },
    { "key": "warehouseId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "itemId", "value": "", "description": "مارکر — کالای مصرفی، برایش CONSUMPTION هم می‌زنیم" },
    { "key": "whiteboardItemId", "value": "", "description": "تخته — کالای غیرمصرفی، ساخته می‌شود با موجودی افتتاحیه و دیگر هیچ‌وقت CONSUMPTION نمی‌خورد" },
    { "key": "transactionId", "value": "" },
    { "key": "throwawayWarehouseId", "value": "" },
    { "key": "throwawayCategoryId", "value": "" }
  ],
  "item": [
    {
      "name": "0. ورود",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 و accessToken دارد', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.have.property('accessToken');",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{identifier}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "1. گدام‌ها",
      "item": [
        {
          "name": "ساخت گدام",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 و id دارد', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.json().id) { pm.collectionVariables.set('warehouseId', pm.response.json().id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"گدام مرکزی\",\n  \"location\": \"طبقه همکف\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/warehouses", "host": ["{{baseUrl}}"], "path": ["warehouses"] }
          }
        },
        {
          "name": "دریافت یک گدام",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/warehouses/{{warehouseId}}", "host": ["{{baseUrl}}"], "path": ["warehouses", "{{warehouseId}}"] }
          }
        },
        {
          "name": "ویرایش گدام",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
