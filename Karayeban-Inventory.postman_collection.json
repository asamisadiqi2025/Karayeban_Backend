                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('COGS = 40*averageCost(3) = 120', function () {",
                  "  pm.expect(body.transaction.costOfGoodsSold).to.eql('120');",
                  "  pm.expect(body.item.quantity).to.eql('110');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"{{itemId}}\",\n  \"type\": \"SALE\",\n  \"quantity\": 40,\n  \"unitPrice\": 6,\n  \"accountId\": \"{{accountId}}\",\n  \"notes\": \"فروش به دوکاندار\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/inventory/transactions", "host": ["{{baseUrl}}"], "path": ["inventory", "transactions"] }
          }
        },
        {
          "name": "CONSUMPTION (مارکر) - مصرف داخلی 10 عدد (بدون accountId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('پول جابه‌جا نشده، فقط موجودی', function () {",
                  "  pm.expect(body.transaction.accountId).to.eql(null);",
                  "  pm.expect(body.item.quantity).to.eql('100');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"itemId\": \"{{itemId}}\",\n  \"type\": \"CONSUMPTION\",\n  \"quantity\": 10,\n  \"notes\": \"مصرف داخلی در دفتر - مارکر تمام شد\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/inventory/transactions", "host": ["{{baseUrl}}"], "path": ["inventory", "transactions"] },
            "description": "مارکر مصرفی است، هفته‌ای که تمام شد این‌طور از موجودی خارج می‌شود. تخته چون مصرف‌شدنی نیست هیچ‌وقت این تراکنش را نمی‌خورد."
          }
        },
        {
          "name": "ADJUSTMENT (مارکر) - کسری شمارش فیزیکی (منفی)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"itemId\": \"{{itemId}}\",\n  \"type\": \"ADJUSTMENT\",\n  \"quantity\": -5,\n  \"notes\": \"کسری شمارش فیزیکی\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/inventory/transactions", "host": ["{{baseUrl}}"], "path": ["inventory", "transactions"] }
          }
        },
        {
          "name": "ADJUSTMENT (مارکر) - اضافی شمارش فیزیکی (مثبت)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"itemId\": \"{{itemId}}\",\n  \"type\": \"ADJUSTMENT\",\n  \"quantity\": 3,\n  \"notes\": \"اضافی شمارش فیزیکی\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/inventory/transactions", "host": ["{{baseUrl}}"], "path": ["inventory", "transactions"] }
          }
        },
        {
          "name": "فهرست تراکنش‌های یک کالا",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/inventory/transactions?itemId={{itemId}}&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["inventory", "transactions"],
              "query": [{ "key": "itemId", "value": "{{itemId}}" }, { "key": "limit", "value": "20" }]
            }
          }
        },
        {
          "name": "دریافت یک تراکنش",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/inventory/transactions/{{transactionId}}", "host": ["{{baseUrl}}"], "path": ["inventory", "transactions", "{{transactionId}}"] }
          }
        }
      ]
    }
  ]
