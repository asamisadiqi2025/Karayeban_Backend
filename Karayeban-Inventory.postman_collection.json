            "body": { "mode": "raw", "raw": "{\n  \"location\": \"طبقه اول - اتاق ۳\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/warehouses/{{warehouseId}}", "host": ["{{baseUrl}}"], "path": ["warehouses", "{{warehouseId}}"] }
          }
        },
        {
          "name": "فهرست گدام‌ها",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/warehouses?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["warehouses"],
              "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }]
            }
          }
        },
        {
          "name": "ساخت گدام یک‌بارمصرف (برای تست حذف)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["if (pm.response.json().id) { pm.collectionVariables.set('throwawayWarehouseId', pm.response.json().id); }"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"گدام تستی حذف\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/warehouses", "host": ["{{baseUrl}}"], "path": ["warehouses"] }
          }
        },
        {
          "name": "حذف گدام خالی (باید 200 بدهد)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', function () { pm.response.to.have.status(200); });"] } }],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/warehouses/{{throwawayWarehouseId}}", "host": ["{{baseUrl}}"], "path": ["warehouses", "{{throwawayWarehouseId}}"] }
          }
        },
        {
          "name": "حذف گدامِ دارای کالا (باید 409 بدهد)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('409 Conflict', function () { pm.response.to.have.status(409); });"] } }],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/warehouses/{{warehouseId}}", "host": ["{{baseUrl}}"], "path": ["warehouses", "{{warehouseId}}"] },
            "description": "فقط بعد از ساخت حداقل یک کالا در همین گدام اجرا کنید تا 409 بگیرید."
          }
        }
      ]
    },
