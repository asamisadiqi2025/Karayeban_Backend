        },
        {
          "name": "0.7 دوکان ۴ (باطل‌سازی/cancel) - C-104",
          "event": [{ "listen": "test", "script": { "exec": [
            "const data = pm.response.json();",
            "if (data.id) { pm.collectionVariables.set('shopId4', data.id); }"
          ]}}],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/shops",
            "body": { "mode": "raw", "raw": "{\n  \"shopNumber\": \"C-104\",\n  \"marketId\": \"{{marketId}}\"\n}" } }
        },
        {
          "name": "0.8 مستاجر ۱ (احمد - قرارداد تازه)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const data = pm.response.json();",
            "if (data.id) { pm.collectionVariables.set('tenantId1', data.id); }"
          ]}}],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/tenants",
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"احمد ولی\",\n  \"marketId\": \"{{marketId}}\"\n}" } }
        },
        {
          "name": "0.8 مستاجر ۲ (کریم - قرارداد قدیمی بدهکار)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const data = pm.response.json();",
            "if (data.id) { pm.collectionVariables.set('tenantId2', data.id); }"
          ]}}],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/tenants",
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"کریم داد\",\n  \"marketId\": \"{{marketId}}\"\n}" } }
        },
        {
          "name": "0.8 مستاجر ۳ (فرید - تست فسخ)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const data = pm.response.json();",
            "if (data.id) { pm.collectionVariables.set('tenantId3', data.id); }"
          ]}}],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/tenants",
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"فرید احمدی\",\n  \"marketId\": \"{{marketId}}\"\n}" } }
        },
        {
          "name": "0.8 مستاجر ۴ (نجیب - تست باطل‌سازی)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const data = pm.response.json();",
            "if (data.id) { pm.collectionVariables.set('tenantId4', data.id); }"
          ]}}],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/tenants",
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"نجیب الله\",\n  \"marketId\": \"{{marketId}}\"\n}" } }
        },
        {
          "name": "0.9 کنتور برق دوکان ۱",
          "event": [{ "listen": "test", "script": { "exec": [
            "const data = pm.response.json();",
            "if (data.id) { pm.collectionVariables.set('meterId1', data.id); }"
          ]}}],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/meters",
            "body": { "mode": "raw", "raw": "{\n  \"shopNumber\": \"F-101\",\n  \"serialNumber\": \"MTR-F-101\",\n  \"lastReading\": 100,\n  \"marketId\": \"{{marketId}}\"\n}" } }
        },
        {
          "name": "0.9 کنتور برق دوکان ۲",
          "event": [{ "listen": "test", "script": { "exec": [
            "const data = pm.response.json();",
            "if (data.id) { pm.collectionVariables.set('meterId2', data.id); }"
          ]}}],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/meters",
            "body": { "mode": "raw", "raw": "{\n  \"shopNumber\": \"L-102\",\n  \"serialNumber\": \"MTR-L-102\",\n  \"lastReading\": 50,\n  \"marketId\": \"{{marketId}}\"\n}" } }
        },
        {
          "name": "0.10 تنظیم دوره‌بندی میترخوانی سال ۱۴۰۵/2026 (هر ۲ ماه یک دوره = ۶ دوره در سال)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/electricity/billing-cycles",
            "body": { "mode": "raw", "raw": "{\n  \"year\": 2026,\n  \"monthsPerPeriod\": 2,\n  \"marketId\": \"{{marketId}}\"\n}" },
            "description": "این یک‌بار برای کل بازار تنظیم می‌شود؛ همه‌ی بل‌های سال ۲۰۲۶ (زنده و تاریخی) از همین استفاده می‌کنند."
          }
        }
      ]
    },
    {
      "name": "۱) قرارداد تازه (بدون بدهی قبلی) - دوکان F-101",
      "item": [
        {
          "name": "1.1 ساخت قرارداد تازه (رایگان از بدهی)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const data = pm.response.json();",
            "if (data.id) { pm.collectionVariables.set('contractIdFresh', data.id); }"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/contracts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shopId\": \"{{shopId1}}\",\n  \"tenantId\": \"{{tenantId1}}\",\n  \"startDate\": \"2026-09-01\",\n  \"endDate\": \"2027-09-01\",\n  \"rent\": 6000,\n  \"currencyId\": \"{{currencyId}}\"\n}"
            },
            "description": "بدون openingRentPaid — قرارداد کاملاً تازه، صفر بدهی."
          }
        },
        {
          "name": "1.2 ⚠️ چک کن: GET بدهی کرایه مستاجر ۱ (نکته‌ی مهم totalDebt vs overdueDebt)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/rent/debts/{{tenantId1}}",
            "description": "⚠️ نکته‌ی مهم: چون همه‌ی فاکتورهای کرایه‌ی کل یک‌سال قرارداد همین الان (در لحظه‌ی ساخت) از قبل ساخته شده‌اند، فیلد totalDebt این‌جا تقریباً کل کرایه‌ی یک‌سال (۷۲,۰۰۰) را نشان می‌دهد — نه فقط چیزی که *تا امروز* باید داده می‌شد! فیلد overdueDebt همان چیزی است که واقعاً می‌خواهید («واقعاً معوق تا امروز») و باید صفر یا نزدیک صفر باشد چون هنوز هیچ ماهی تمام نشده. این رفتار را در پاسخ چت هم به‌عنوان یک یافته گزارش کردم — اگر داشبورد شما مستقیم totalDebt را به‌عنوان «بدهی مستاجر» نشان می‌دهد، این گمراه‌کننده است."
          }
        },
        {
          "name": "1.3 پرداخت جزئی کرایه (POST /rent/payments)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/rent/payments",
            "body": { "mode": "raw", "raw": "{\n  \"contractId\": \"{{contractIdFresh}}\",\n  \"amount\": 2000,\n  \"accountId\": \"{{accountId}}\",\n  \"notes\": \"پرداخت اول ماه\"\n}" }
          }
        },
        {
          "name": "1.4 GET فاکتورهای کرایه‌ی این قرارداد (باید فاکتور اول PARTIAL باشد)",
          "request": { "method": "GET", "url": "{{baseUrl}}/rent/charges?contractId={{contractIdFresh}}" }
        }
      ]
    },
    {
      "name": "۲) قرارداد قدیمی وسط‌راه: بدهی کرایه+برق، کاهش قیمت وسط قرارداد، تخفیف - دوکان L-102",
      "item": [
        {
          "name": "2.1 ساخت قرارداد قدیمی (شروع ۶ ماه قبل، رایه ۵۰۰۰، پرداخت افتتاحیه ۱۵۰۰۰)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const data = pm.response.json();",
            "if (data.id) { pm.collectionVariables.set('contractIdLegacy', data.id); }"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/contracts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shopId\": \"{{shopId2}}\",\n  \"tenantId\": \"{{tenantId2}}\",\n  \"startDate\": \"2026-03-28\",\n  \"endDate\": \"2027-03-28\",\n  \"rent\": 5000,\n  \"currencyId\": \"{{currencyId}}\",\n  \"openingRentPaid\": 15000\n}"
            },
            "description": "معادل: از ۲ حمل با ۵۰۰۰ شروع شده. openingRentPaid=15000 دقیقاً برابر ۳ ماه اول (۳×۵۰۰۰) است — یعنی طبق دفتر کاغذی همین مقدار تا الان داده. سیستم فاکتورهای کل قرارداد را می‌سازد (همه با ۵۰۰۰) و این ۱۵,۰۰۰ را FIFO روی ۳ ماه اول می‌ریزد (کامل تسویه)."
          }
        },
        {
          "name": "2.2 کاهش قیمت از ماه چهارم (adjust-rent: 5000 → 4000 از 2026-06-28)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/contracts/{{contractIdLegacy}}/adjust-rent",
            "body": { "mode": "raw", "raw": "{\n  \"newRent\": 4000,\n  \"effectiveFrom\": \"2026-06-28\",\n  \"reason\": \"افت بازار\"\n}" },
            "description": "این تاریخ دقیقاً معادل شروع دوره‌ی چهارم است (هر دوره ۱ ماه از startDate است، نه اول ماه تقویمی) — پس فقط فاکتورهای ماه ۴ به بعد (که هنوز PENDING اند) به ۴۰۰۰ تغییر می‌کنند؛ ۳ ماه اول (که با openingRentPaid تسویه شدند) دست‌نخورده با ۵۰۰۰ می‌مانند. ⚠️ نکته‌ی مهم که در چت گزارش کردم: این endpoint هیچ محدودیتی روی «فقط کاهش مجاز است» ندارد — اگر همین درخواست را با newRent بزرگ‌تر از رایه فعلی بزنید (مثلاً 6000)، سیستم بدون خطا قبول می‌کند! این برخلاف قانون کسب‌وکاری است که خودتان گفتید (قیمت فقط می‌تواند پایین بیاید). اگر می‌خواهید همین الان این validation را اضافه کنم بگویید."
          }
        },
        {
          "name": "2.3 GET فاکتورهای کرایه (چک کن: ۳ ماه اول=۵۰۰۰ PAID، بقیه=۴۰۰۰ PENDING)",
          "request": { "method": "GET", "url": "{{baseUrl}}/rent/charges?contractId={{contractIdLegacy}}" }
        },
        {
          "name": "2.4 بخشش بخشی از بدهی کرایه (discount-debt: 2000)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/contracts/{{contractIdLegacy}}/discount-debt",
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 2000,\n  \"reason\": \"تسویه با تخفیف، توافق صاحب‌کار\"\n}" },
            "description": "روی قدیمی‌ترین فاکتور بازِ (ماه ۴، که ۴۰۰۰ است) اعمال می‌شود؛ discountAmount آن فاکتور را ۲۰۰۰ می‌کند تا در گزارش هم «بدهی واقعی» هم «بخشش» جدا دیده شود."
          }
        },
        {
          "name": "2.5 ثبت دسته‌ای بل‌های تاریخی برق (bills/bulk با isOpeningEntry - دوره‌های ۲،۳،۴)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/electricity/bills/bulk",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bills\": [\n    { \"contractId\": \"{{contractIdLegacy}}\", \"year\": 2026, \"periodNumber\": 2, \"totalAmount\": 1500, \"currencyId\": \"{{currencyId}}\", \"isOpeningEntry\": true, \"notes\": \"مهاجرت از دفتر کاغذی\" },\n    { \"contractId\": \"{{contractIdLegacy}}\", \"year\": 2026, \"periodNumber\": 3, \"totalAmount\": 1500, \"currencyId\": \"{{currencyId}}\", \"isOpeningEntry\": true, \"notes\": \"مهاجرت از دفتر کاغذی\" },\n    { \"contractId\": \"{{contractIdLegacy}}\", \"year\": 2026, \"periodNumber\": 4, \"totalAmount\": 1500, \"currencyId\": \"{{currencyId}}\", \"isOpeningEntry\": true, \"notes\": \"مهاجرت از دفتر کاغذی\" }\n  ]\n}"
            },
            "description": "سه دوره‌ی گذشته (دوره ۲=مارچ-آپریل، ۳=می-جون، ۴=جولای-آگست) یک‌جا ثبت می‌شوند — هر کدام ۱۵۰۰، بدون قرائت کنتور، دقیقاً مثل بدهی برق روی کاغذ. دوره‌ی جاری (۵) عمداً اینجا ثبت نمی‌شود چون هنوز تمام نشده."
          }
        },
        {
          "name": "2.6 پرداخت یک‌جای بدهی برق تاریخی (payments/opening: 3000)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/electricity/payments/opening",
