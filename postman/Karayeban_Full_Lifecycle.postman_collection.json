{
  "info": {
    "name": "Karayeban Backend - Full Lifecycle Test (Contract + Rent + Electricity)",
    "description": "تست سر تا ته: قرارداد تازه، قرارداد قدیمی با بدهی کرایه/برق + کاهش قیمت وسط قرارداد + تخفیف، تمدید/فسخ/باطل‌سازی، بدهی قسطی کرایه، دوره‌بندی و بل برق زنده، و تسویه‌ی نهایی. ترتیب پوشه‌ها را رعایت کنید چون هر مرحله به ID های مرحله‌ی قبل نیاز دارد (خودکار در متغیرهای کالکشن ذخیره می‌شوند).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "superAdminSecret", "value": "", "description": "از .env مقدار SUPER_ADMIN_REGISTRATION_SECRET را اینجا بگذارید" },
    { "key": "accessToken", "value": "" },
    { "key": "marketId", "value": "" },
    { "key": "currencyId", "value": "" },
    { "key": "accountId", "value": "" },
    { "key": "shopId1", "value": "" },
    { "key": "shopId2", "value": "" },
    { "key": "shopId3", "value": "" },
    { "key": "shopId4", "value": "" },
    { "key": "tenantId1", "value": "" },
    { "key": "tenantId2", "value": "" },
    { "key": "tenantId3", "value": "" },
    { "key": "tenantId4", "value": "" },
    { "key": "meterId1", "value": "" },
    { "key": "meterId2", "value": "" },
    { "key": "contractIdFresh", "value": "" },
    { "key": "contractIdLegacy", "value": "" },
    { "key": "contractIdTerminate", "value": "" },
    { "key": "contractIdCancel", "value": "" },
    { "key": "electricityBillIdLive", "value": "" }
  ],
  "item": [
    {
      "name": "۰) راه‌اندازی (Setup)",
      "item": [
        {
          "name": "0.1 ثبت سوپرادمین اول",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register-super-admin",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"superadmin1\",\n  \"email\": \"superadmin1@example.com\",\n  \"password\": \"Passw0rd1\",\n  \"fullName\": \"مدیر کل سیستم\",\n  \"secret\": \"{{superAdminSecret}}\"\n}"
            },
            "description": "اگر قبلاً یک سوپرادمین ساخته‌اید، این مرحله با خطا (کاربر تکراری) رد می‌شود — مشکلی نیست، برو مرحله‌ی بعد (لاگین) با همان ایمیل/پسورد."
          }
        },
        {
          "name": "0.2 ورود (Login)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const data = pm.response.json();",
            "if (data.accessToken) { pm.collectionVariables.set('accessToken', data.accessToken); }",
            "pm.test('login ok', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"superadmin1@example.com\",\n  \"password\": \"Passw0rd1\"\n}"
            }
          }
        },
        {
          "name": "0.3 ساخت بازار (Market)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const data = pm.response.json();",
            "if (data.id) { pm.collectionVariables.set('marketId', data.id); }"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/markets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"بازار مرکزی تست\",\n  \"address\": \"کابل، شهرنو\",\n  \"subdomain\": \"karayeban-test-{{$timestamp}}\"\n}"
            }
          }
        },
        {
