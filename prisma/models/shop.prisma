model Shop {
  id         String     @id @default(uuid()) @db.Uuid
  marketId   String     @map("market_id") @db.Uuid
  floorId    String?    @map("floor_id") @db.Uuid
  shopNumber String     @map("shop_number") @db.VarChar(50)
  area       Decimal?   @db.Decimal(12, 2)
  location   String?    @db.VarChar(255)
  type       ShopType   @default(shop)
  status     ShopStatus @default(empty)
  details    String?    @db.Text

  currentContractId String? @unique @map("current_contract_id") @db.Uuid
  currentTenantId   String? @map("current_tenant_id") @db.Uuid

  // isActive یعنی «آیا این دوکان در سیستم فعال/آرشیو نشده» (حذف نرم) — بعد جدا از status
  // که وضعیت اشغال روزمره (فعال/غیرفعال/خالی/کرایه‌داده‌شده) را نشان می‌دهد.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  floor  Floor? @relation(fields: [floorId], references: [id], onDelete: SetNull)

  currentContract Contract? @relation("CurrentShopContract", fields: [currentContractId], references: [id], onDelete: SetNull)
  currentTenant   Tenant?   @relation(fields: [currentTenantId], references: [id], onDelete: SetNull)

  contracts           Contract[]           @relation("ContractPrimaryShop")
  contractShops       ContractShop[]
  rentPayments        RentPayment[]
  rentCharges         RentCharges[]
  electricityMeters   ElectricityMeter[]
  electricityBills    ElectricityBill[]
  electricityPayments ElectricityPayment[]
  shopGroupMembers    ShopGroupMember[]
  lotteryEntries      LotteryEntry[]

  @@unique([marketId, shopNumber])
  @@index([marketId])
  @@index([floorId])
  @@map("shops")
}
