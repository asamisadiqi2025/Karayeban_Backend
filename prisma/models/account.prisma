enum AccountType {
  CASH
  BANK
}

model Account {
  id         String @id @default(uuid()) @db.Uuid
  marketId   String @map("market_id") @db.Uuid
  currencyId String @map("currency_id") @db.Uuid

  name String
  type AccountType

  accountNumber String? @map("account_number")
  bankName      String? @map("bank_name")

  balance Decimal @default(0) @db.Decimal(18, 4)

  isActive Boolean @default(true) @map("is_active")
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  market   Market   @relation(fields: [marketId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])

  openingBalances OpeningBalance[]

  expenses                 Expense[]
  rentPayments             RentPayment[]
  rentCharges              RentCharges[]
  miscellaneousIncome      MiscellaneousIncome[]
  electricityPayments      ElectricityPayment[]
  shareholderTransactions  ShareholderTransaction[]
  collateralItems          CollateralItem[]
  inventoryTransactions    InventoryTransaction[]
  securityDepositContracts Contract[]

  transfersOut AccountTransfer[] @relation("TransferFrom")
  transfersIn  AccountTransfer[] @relation("TransferTo")

  accountTransactions AccountTransaction[]

  dealerLoans      DealerLoan[]
  dealerRepayments DealerRepayment[]

  ledgerEntries LedgerEntry[]

  @@unique([marketId, name])
  @@index([marketId])
  @@index([currencyId])
  @@map("accounts")
}

// انتقال پول بین دو «بانک/دخل» داخلی (مثلاً صرافی حاجی داود ← دخل مارکت).
// هر دو حساب باید متعلق به یک Market باشند؛ این قید در سطح سرویس اعمال می‌شود
// چون Prisma/Postgres راهی برای مقایسهٔ marketId دو ردیف مرتبط در سطح schema ندارد.
// هم‌ارز (AFN←AFN) و بین‌ارزی (AFN←USD با شکستن به نرخ روز) هر دو پشتیبانی می‌شوند —
// ن.ک. amount/receivedAmount/exchangeRate.
model AccountTransfer {
  id            String @id @default(uuid()) @db.Uuid
  marketId      String @map("market_id") @db.Uuid
  fromAccountId String @map("from_account_id") @db.Uuid
  toAccountId   String @map("to_account_id") @db.Uuid

  amount Decimal @db.Decimal(18, 4)

  receivedAmount Decimal @map("received_amount") @db.Decimal(18, 4)

  // نرخِ تبدیلِ «مبدا → مقصد» (۱ واحد ارز مبدا = exchangeRate واحد ارز مقصد)؛ فقط انتقالِ بین‌ارزی.
  exchangeRate Decimal? @map("exchange_rate") @db.Decimal(24, 10)

  // اسنپ‌شاتِ ارز پایه در لحظهٔ انتقال: نرخِ هر ارز به ارز پایه (۱ واحد = X ارز پایه) و ارزشِ
  // مبلغِ خارج‌شده و دریافت‌شده به ارز پایه. اگر نرخِ دستیِ انتقال با نرخ‌های سیستم نخواند، تفاوتِ
  // این دو ارزش همان «سود/زیانِ ارزی» همین انتقال است.
  fromRateToBase             Decimal? @map("from_rate_to_base") @db.Decimal(24, 10)
  toRateToBase               Decimal? @map("to_rate_to_base") @db.Decimal(24, 10)
  baseCurrencyAmount         Decimal? @map("base_currency_amount") @db.Decimal(18, 4)
  receivedBaseCurrencyAmount Decimal? @map("received_base_currency_amount") @db.Decimal(18, 4)

  transferDate DateTime @map("transfer_date") @db.Timestamptz(6)
  notes        String?  @db.Text

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  market      Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  fromAccount Account @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   Account @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  createdBy   User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  ledgerEntries LedgerEntry[]

  @@index([marketId])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("account_transfers")
}
