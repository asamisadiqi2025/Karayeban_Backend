  unit // واحد
  stall // بساط
}

// خالی → (وقتی قراردادی برای این دوکان ساخته شد ولی هنوز شروع نشده) pending →
// (وقتی تاریخ شروع قرارداد رسید) rented. active/inactive مستقل از اجاره‌داری‌اند:
// وضعیت باز/بستهٔ روزمرهٔ دوکان، نه اینکه مستأجر دارد یا نه (جدا از isActive که حذف نرم است).
