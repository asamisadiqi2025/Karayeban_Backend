model ElectricityMeter {
  id              String      @id @default(uuid()) @db.Uuid
  marketId        String      @map("market_id") @db.Uuid
  meterNumber     String?     @map("meter_number")
  serialNumber    String?     @map("serial_number") // شمارهٔ فیزیکی سخت‌افزار کنتور — مفهومی جدا از meterNumber
  shopId          String?     @map("shop_id") @db.Uuid
  status          MeterStatus @default(active)
  location        String?     @db.VarChar(255)
  lastReading     Decimal?    @map("last_reading") @db.Decimal(12, 2)
  lastReadingDate DateTime?   @map("last_reading_date") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  market              Market            @relation(fields: [marketId], references: [id], onDelete: Cascade)
  shop                Shop?             @relation(fields: [shopId], references: [id], onDelete: SetNull)
  primaryForShopGroup ShopGroup?        @relation("PrimaryMeterForShopGroup")
  bills               ElectricityBill[]

  @@unique([marketId, meterNumber])
  @@unique([marketId, serialNumber])
  @@unique([shopId])
  @@index([shopId])
  @@index([status])
  @@map("electricity_meters")
}

enum ElectricityBillStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELED
}

// دورهٔ میترخوانی هر بازار در هر سال شمسی: هر ۱ ماه (۱۲ دوره) یا هر ۲ ماه (۶ دوره) یا هر
// طول دیگری که ۱۲ را بدون باقی‌مانده تقسیم کند. یک رکورد per (marketId, year) — تصمیمِ
// «امسال چند دوره داریم» مستقل برای هر بازار و هر سال است و سال‌های گذشته را تغییر نمی‌دهد.
// دورهٔ شمارهٔ N شامل ماه‌های شمسیِ [(N-1)*monthsPerPeriod+1 .. N*monthsPerPeriod] است
// (حمل=۱) — periodStart/periodEnd هر ElectricityBill از همین‌جا محاسبه می‌شود، نه آزاد.
model ElectricityBillingCycle {
  id              String @id @default(uuid()) @db.Uuid
  marketId        String @map("market_id") @db.Uuid
  year            Int
  monthsPerPeriod Int    @map("months_per_period")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  market Market            @relation(fields: [marketId], references: [id], onDelete: Cascade)
  bills  ElectricityBill[]

  @@unique([marketId, year])
  @@map("electricity_billing_cycles")
}

model ElectricityBill {
  id         String  @id @default(uuid()) @db.Uuid
  marketId   String  @map("market_id") @db.Uuid
  shopId     String  @map("shop_id") @db.Uuid
  meterId    String? @map("meter_id") @db.Uuid
  tenantId   String? @map("tenant_id") @db.Uuid
  contractId String? @map("contract_id") @db.Uuid

  // سال شمسی + شمارهٔ دوره (طبق ElectricityBillingCycle همان بازار/سال) — منبع حقیقتِ
  // periodStart/periodEnd زیر؛ nullable فقط برای سازگاری با بل‌های دستیِ قدیمی‌تر.
  billingCycleId String? @map("billing_cycle_id") @db.Uuid
  year           Int?
  periodNumber   Int?    @map("period_number")

  periodStart     DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd       DateTime @map("period_end") @db.Timestamptz(6)
  previousReading Decimal? @map("previous_reading") @db.Decimal(12, 2)
  currentReading  Decimal? @map("current_reading") @db.Decimal(12, 2)

  totalAmount     Decimal @map("total_amount") @db.Decimal(18, 4)
  paidAmount      Decimal @default(0) @map("paid_amount") @db.Decimal(18, 4)
  remainingAmount Decimal @default(0) @map("remaining_amount") @db.Decimal(18, 4)

  currencyId     String                @map("currency_id") @db.Uuid
  status         ElectricityBillStatus @default(PENDING)
  isOpeningEntry Boolean               @default(false) @map("is_opening_entry")

  notes       String? @db.Text
  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  market       Market                   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  shop         Shop                     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  meter        ElectricityMeter?        @relation(fields: [meterId], references: [id], onDelete: SetNull)
  tenant       Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  contract     Contract?                @relation(fields: [contractId], references: [id], onDelete: SetNull)
  billingCycle ElectricityBillingCycle? @relation(fields: [billingCycleId], references: [id], onDelete: SetNull)
  currency     Currency                 @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  createdBy    User?                    @relation("ElectricityBillCreator", fields: [createdById], references: [id], onDelete: SetNull)

  allocations ElectricityPaymentAllocation[]

  // یک بیل به‌ازای هر (قرارداد، سال، شمارهٔ دوره) — nullable بودن contractId/year/periodNumber
  // یعنی این قید فقط روی بل‌های جدیدِ مبتنی‌بر دوره اعمال می‌شود، نه بل‌های دستیِ قدیمی.
  @@unique([contractId, year, periodNumber])
  @@index([marketId])
  @@index([shopId])
  @@index([tenantId])
  @@index([contractId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@map("electricity_bills")
}

model ElectricityDebt {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  totalDebt         Decimal   @default(0) @map("total_debt") @db.Decimal(18, 4)
  lastBillAmount    Decimal   @default(0) @map("last_bill_amount") @db.Decimal(18, 4)
  lastPaymentAmount Decimal   @default(0) @map("last_payment_amount") @db.Decimal(18, 4)
  lastBillDate      DateTime? @map("last_bill_date") @db.Timestamptz(6)
  lastPaymentDate   DateTime? @map("last_payment_date") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("electricity_debts")
}

model ElectricityPayment {
  id             String            @id @default(uuid()) @db.Uuid
  marketId       String            @map("market_id") @db.Uuid
  shopId         String            @map("shop_id") @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  amount         Decimal           @db.Decimal(18, 4)
  currencyId     String            @map("currency_id") @db.Uuid
  paymentDate    DateTime          @map("payment_date") @db.Timestamptz(6)
  paymentMethod  PaymentMethod     @map("payment_method")
  accountId      String?           @map("account_id") @db.Uuid
  source         PaymentSourceType @default(BANK)
  isOpeningEntry Boolean           @default(false) @map("is_opening_entry")
  collectedById  String?           @map("collected_by_id") @db.Uuid
  receiptNumber  String?           @map("receipt_number") @db.VarChar(100)
  notes          String?           @db.Text
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  market      Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  currency    Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  collectedBy User?    @relation("ElectricityCollectedBy", fields: [collectedById], references: [id], onDelete: SetNull)

  allocations ElectricityPaymentAllocation[]
  ledgerEntry LedgerEntry?

  @@index([marketId])
  @@index([shopId])
  @@index([tenantId])
  @@map("electricity_payments")
}

model ElectricityPaymentAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  billId    String   @map("bill_id") @db.Uuid
  amount    Decimal  @db.Decimal(18, 4)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment ElectricityPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill    ElectricityBill    @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([paymentId, billId])
  @@index([paymentId])
  @@index([billId])
  @@map("electricity_payment_allocations")
}

model DepreciationEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  assetId            String   @map("asset_id") @db.Uuid // 👈 اضافه شد
  year               Int
  depreciationAmount Decimal  @map("depreciation_amount") @db.Decimal(18, 4)
  bookValueBefore    Decimal  @map("book_value_before") @db.Decimal(18, 4)
  bookValueAfter     Decimal  @map("book_value_after") @db.Decimal(18, 4)
  appliedAt          DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)
  appliedById        String?  @map("applied_by_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  asset     Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  appliedBy User? @relation("DepreciationAppliedBy", fields: [appliedById], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@map("depreciation_events")
}
