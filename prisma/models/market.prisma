model Market {
  id                     String   @id @default(uuid()) @db.Uuid
  name                   String   @db.VarChar(200)
  nameEn                 String?  @map("name_en") @db.VarChar(200)
  subdomain              String   @unique @db.VarChar(63)
  logo                   String?  @db.Text
  address                String?  @db.Text
  phone                  String?  @db.VarChar(30)
  email                  String?  @db.VarChar(255)
  details                String?  @db.Text
  baseCurrencyId         String?  @map("base_currency_id") @db.Uuid
  isSetupComplete        Boolean  @default(false)
  // نرخ برق (پول به‌ازای هر واحد مصرف) — یک عدد ثابت برای کل مارکت، همهٔ کنتورها از همین
  // استفاده می‌کنند؛ فقط از پروفایل مارکت قابل تغییر است (نیازی به وارد کردنش هر بار نیست).
  electricityRatePerUnit Decimal  @default(18.5) @map("electricity_rate_per_unit") @db.Decimal(18, 4)
  // ارزِ همین نرخِ برق — عمداً جدا از baseCurrency، چون در عمل ممکن است با هم فرق کنند
  // (مثلاً ارز پایهٔ مارکت دالر باشد ولی برق همیشه افغانی حساب شود). بل‌های زنده (نه
  // isOpeningEntry) ارزشان را همیشه از همین فیلد می‌خوانند، نه از ورودیِ آزادِ کاربر —
  // تا اشتباهِ دالر/افغانی اصلاً ممکن نباشد. برخلاف baseCurrency، این یک‌بار قفل نمی‌شود.
  electricityRateCurrencyId String? @map("electricity_rate_currency_id") @db.Uuid
  createdAt              DateTime @default(now()) @db.Timestamp(6)
  updatedAt              DateTime @updatedAt @db.Timestamp(6)

  baseCurrency            Currency? @relation(fields: [baseCurrencyId], references: [id], onDelete: SetNull)
  electricityRateCurrency Currency? @relation("MarketElectricityRateCurrency", fields: [electricityRateCurrencyId], references: [id], onDelete: SetNull)

  customRoles              CustomRole[]
  marketCurrencies         MarketCurrency[]
  users                    User[]
  accounts                 Account[]
  auditLogs                AuditLog[]
  contracts                Contract[]
  expenses                 Expense[]
  floors                   Floor[]
  miscellaneousIncome      MiscellaneousIncome[]
  openingBalances          OpeningBalance[]
  rentCharges              RentCharges[]
  rentPayments             RentPayment[]
  shopGroups               ShopGroup[]
  shops                    Shop[]
  tenants                  Tenant[]
  assets                   Asset[]
  assetCategories          AssetCategory[]
  dealers                  Dealer[]
  dealerLoans              DealerLoan[]
  dealerRepayments         DealerRepayment[]
  shareholders             Shareholder[]
  shareholderTransactions  ShareholderTransaction[]
  accountTransfers         AccountTransfer[]
  accountTransactions      AccountTransaction[]
  electricityBills         ElectricityBill[]
  electricityPayments      ElectricityPayment[]
  electricityMeters        ElectricityMeter[]
  electricityBillingCycles ElectricityBillingCycle[]
  collateralItems          CollateralItem[]
  lotteryDraws             LotteryDraw[]
  exchangeRates            ExchangeRate[]
  expenseCategories        ExpenseCategory[]
  ledgerEntries            LedgerEntry[]
  guarantors               Guarantor[]
  warehouses               Warehouse[]
  inventoryCategories      InventoryCategory[]
  inventoryUnits           InventoryUnit[]
  inventoryItems           InventoryItem[]
  inventoryTransactions    InventoryTransaction[]

  @@map("markets")
}
