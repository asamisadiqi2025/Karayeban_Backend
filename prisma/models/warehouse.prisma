model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  marketId  String   @map("market_id") @db.Uuid
  name      String   @db.VarChar(150)
  location  String?  @db.VarChar(255)
  details   String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  assets                Asset[]

  // یکتاییِ نام فقط بین گدام‌های فعال (isDeleted=false) با یک ایندکس شرطی در سطح
  // دیتابیس اعمال می‌شود (ن.ک. migration «warehouse_partial_unique_active_name»)،
  // نه با @@unique معمولی — وگرنه نامِ یک گدامِ حذف‌شده برای همیشه قابل استفادهٔ
  // مجدد نمی‌ماند.
  @@index([marketId, name])
  @@index([marketId])
  @@map("warehouses")
}
