// تاریخچهٔ نرخ تبدیل هر ارز به ارز پایهٔ مارکت — به‌جای یک عدد تکی روی Market که با نرخ جدید گم می‌شد.
// چند جفت ارز هم‌زمان (مثلاً AFN↔USD و AFN↔PKR) و نرخ هر روز/دوره قابل نگه‌داری است.
model ExchangeRate {
  id            String   @id @default(uuid()) @db.Uuid
  marketId      String   @map("market_id") @db.Uuid
  currencyId    String   @map("currency_id") @db.Uuid
  // ۱۰ رقم اعشار (نه ۶) عمداً — برای ارزهای کم‌ارزش مثل تومان (۱ دلار ≈ ۶۰۰٬۰۰۰+ تومان)،
  // نرخ هر واحد نسبت به ارز پایه عددی مثل 0.0000016667 می‌شود؛ با ۶ رقم اعشار این به
  // 0.000002 گرد می‌شد (~۲۰٪ خطا) — دقیقاً چیزی که در یک سیستم مالی نباید اتفاق بیفتد.
  rateToBase    Decimal  @map("rate_to_base") @db.Decimal(24, 10)
  effectiveDate DateTime @map("effective_date") @db.Date

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  currency  Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([marketId, currencyId, effectiveDate])
  @@index([marketId])
  @@index([currencyId, effectiveDate])
  @@map("exchange_rates")
}
