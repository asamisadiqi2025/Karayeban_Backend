generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"

}

// ============================================================
// ENUMS
// ============================================================

enum MarketStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum ShopStatus {
  EMPTY
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  MOVED_OUT
  BLACKLISTED
}

enum DebtStatus {
  PAID
  DEBTOR
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  TERMINATED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum UtilityType {
  ELECTRICITY
  WATER
  CLEANING
  SECURITY
  OTHER
}

enum UtilityPaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum AccountType {
  CASH
  BANK
  MOBILE_MONEY
  OTHER
}

enum Currency {
  AFN
  USD
  EUR
  GBP
  OTHER
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum ChequeStatus {
  PENDING
  RECEIVED
  RETURNED
}

enum DocumentEntityType {
  TENANT
  CONTRACT
  SHOP
  GUARANTOR
  CHEQUE
  MARKET
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InvestmentType {
  CASH
  EQUIPMENT
  CONSTRUCTION
  OTHER
}

// ============================================================
// CORE / STRUCTURE
// ============================================================

model Market {
  id String @id @default(uuid()) @db.Uuid

  name String
  code String @unique

  address String?
  phone   String?

  status MarketStatus @default(ACTIVE)

  // Relations
  floors                Floor[]
  shops                 Shop[]
  shopCategories        ShopCategory[]
  tenants               Tenant[]
  contracts             Contract[]
  rentPayments          RentPayment[]
  utilityBills          UtilityBill[]
  expenseCategories     ExpenseCategory[]
  employees             Employee[]
  marketExpenses        MarketExpense[]
  accounts              Account[]
  miscellaneousIncomes  MiscellaneousIncome[]
  accountTransactions   AccountTransaction[]
  exitClearances        ExitClearance[]
  cheques               Cheque[]
  documents             Document[]
  users                 User[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  shareholders          Shareholder[]
  additionalInvestments AdditionalInvestment[]
  withdrawals           Withdrawal[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("markets")
}

model Floor {
  id String @id @default(uuid()) @db.Uuid

  marketId String @db.Uuid
  market   Market @relation(fields: [marketId], references: [id])

  name         String
  displayOrder Int
  description  String?

  shops Shop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([marketId])
  @@map("floors")
}

model Shop {
  id String @id @default(uuid()) @db.Uuid

  marketId   String  @db.Uuid
  floorId    String  @db.Uuid
  categoryId String? @db.Uuid

  market   Market        @relation(fields: [marketId], references: [id])
  floor    Floor         @relation(fields: [floorId], references: [id])
  category ShopCategory? @relation(fields: [categoryId], references: [id])

  shopCode           String
  shopNumber         String
  rentAmount         Decimal @db.Decimal(12, 2)
  areaInSquareMeters Decimal @db.Decimal(10, 2)

  electricityMeterNumber String?
  waterMeterNumber       String?

  status ShopStatus @default(EMPTY)

  // Relations
  contracts      Contract[]
  rentPayments   RentPayment[]
  utilityBills   UtilityBill[]
  exitClearances ExitClearance[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([marketId, shopCode])
  @@index([marketId])
  @@map("shops")
}

model ShopCategory {
  id String @id @default(uuid()) @db.Uuid

  marketId String @db.Uuid
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  name        String
  description String?

  shops Shop[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([marketId])
  @@map("shop_categories")
}

// ============================================================
// TENANTS / GUARANTORS
// ============================================================

model Tenant {
  id String @id @default(uuid()) @db.Uuid

  marketId String @db.Uuid
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String

  nationalId String?

  phone          String
  secondaryPhone String?
  emergencyPhone String?

  address String?

  businessName String?

  gender    Gender?
  birthdate DateTime?

  imageUrl String?

  status     TenantStatus @default(ACTIVE)
  debtStatus DebtStatus   @default(PAID)

  description String?

  // Relations
  contracts      Contract[]
  guarantors     Guarantor[]
  cheques        Cheque[]
  exitClearances ExitClearance[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([marketId])
  @@map("tenants")
}

model Guarantor {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  fullName    String
  phone       String
  address     String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("guarantors")
}

// ============================================================
// CONTRACTS
// ============================================================

model Contract {
  id String @id @default(uuid()) @db.Uuid

  marketId String @db.Uuid
  shopId   String @db.Uuid
  tenantId String @db.Uuid

  market Market @relation(fields: [marketId], references: [id])
  shop   Shop   @relation(fields: [shopId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  contractNumber String

  previousContractId String?    @db.Uuid
  previousContract   Contract?  @relation("ContractHistory", fields: [previousContractId], references: [id])
  nextContracts      Contract[] @relation("ContractHistory")

  startDate DateTime
  endDate   DateTime?

  monthlyRent   Decimal @db.Decimal(12, 2)
  depositAmount Decimal @db.Decimal(12, 2)

  status ContractStatus @default(ACTIVE)

  signedAt DateTime?

  approvedBy        String?
  terminatedBy      String?
  terminationReason String?

  // Relations
  terms         ContractTerm[]
  rentPayments  RentPayment[]
  cheques       Cheque[]
  exitClearance ExitClearance?

  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([marketId, contractNumber])
  @@index([shopId])
  @@index([tenantId])
  @@map("contracts")
}

model ContractTerm {
  id String @id @default(uuid()) @db.Uuid

  contractId String   @db.Uuid
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  workingHours         String?
  monthlyHoliday       Int?
  terminationCondition String?
  specialConditions    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
  @@map("contract_terms")
}

// ============================================================
// PAYMENTS / UTILITIES
// ============================================================

model RentPayment {
  id String @id @default(uuid()) @db.Uuid

  marketId   String @db.Uuid
  shopId     String @db.Uuid
  contractId String @db.Uuid

  market   Market   @relation(fields: [marketId], references: [id])
  shop     Shop     @relation(fields: [shopId], references: [id])
  contract Contract @relation(fields: [contractId], references: [id])

  amountDue       Decimal @db.Decimal(12, 2)
  amountPaid      Decimal @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal @db.Decimal(12, 2)

  paymentDate   DateTime?
  paymentMethod String?

  status PaymentStatus @default(PENDING)

  year Int

  lateFee  Decimal? @db.Decimal(12, 2)
  discount Decimal? @db.Decimal(12, 2)

  accountId  String? @db.Uuid
  receivedBy String?

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([marketId])
  @@index([contractId])
  @@map("rent_payments")
}

model UtilityBill {
  id String @id @default(uuid()) @db.Uuid

  marketId String @db.Uuid
  shopId   String @db.Uuid

  market Market @relation(fields: [marketId], references: [id])
  shop   Shop   @relation(fields: [shopId], references: [id])

  type UtilityType

  previousMeter Decimal? @db.Decimal(12, 3)
  currentMeter  Decimal? @db.Decimal(12, 3)
  unitsConsumed Decimal? @db.Decimal(12, 3)
  rate          Decimal? @db.Decimal(12, 2)
  amount        Decimal  @db.Decimal(12, 2)

  billMonth Int
  billYear  Int

  dueDate DateTime?

  status UtilityPaymentStatus @default(PENDING)

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([marketId])
  @@index([shopId])
  @@map("utility_bills")
}

// ============================================================
// EXPENSES / EMPLOYEES
// ============================================================

model ExpenseCategory {
  id String @id @default(uuid()) @db.Uuid

  marketId String @db.Uuid
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  name        String
  description String?

  expenses MarketExpense[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([marketId])
  @@map("expense_categories")
}

model Employee {
  id String @id @default(uuid()) @db.Uuid

  marketId String @db.Uuid
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  fullName String
  phone    String?
  position String?

  salary Decimal? @db.Decimal(12, 2)

  status EmployeeStatus @default(ACTIVE)

  expenses MarketExpense[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([marketId])
  @@map("employees")
}

model MarketExpense {
  id String @id @default(uuid()) @db.Uuid

  marketId   String  @db.Uuid
  categoryId String  @db.Uuid
  employeeId String? @db.Uuid
  accountId  String? @db.Uuid

  market   Market          @relation(fields: [marketId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  employee Employee?       @relation(fields: [employeeId], references: [id])
  account  Account?        @relation(fields: [accountId], references: [id])

  expenseNumber String

  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime

  description String?
  createdBy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([marketId, expenseNumber])
  @@index([marketId])
  @@map("market_expenses")
}

// ============================================================
// ACCOUNTS / FINANCE
// ============================================================

model Account {
  id String @id @default(uuid()) @db.Uuid

  marketId String @db.Uuid
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  name String
  type AccountType
  currency Currency

  description String?

  currentBalance Decimal @default(0) @db.Decimal(14, 2)

  // Relations
  expenses     MarketExpense[]
  incomes      MiscellaneousIncome[]
  transactions AccountTransaction[]
  withdrawals  Withdrawal[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([marketId])
  @@map("accounts")
}

model MiscellaneousIncome {
  id String @id @default(uuid()) @db.Uuid

  marketId  String @db.Uuid
  accountId String @db.Uuid

  market  Market  @relation(fields: [marketId], references: [id])
  account Account @relation(fields: [accountId], references: [id])

  source     String
  amount     Decimal  @db.Decimal(12, 2)
  incomeDate DateTime

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([marketId])
  @@map("miscellaneous_income")
}

model AccountTransaction {
  id String @id @default(uuid()) @db.Uuid

  marketId  String @db.Uuid
  accountId String @db.Uuid

  market  Market  @relation(fields: [marketId], references: [id])
  account Account @relation(fields: [accountId], references: [id])

  type   TransactionType
  amount Decimal         @db.Decimal(14, 2)

  referenceType String?
  referenceId   String?

  balanceAfterTransaction Decimal @db.Decimal(14, 2)

  description String?
  createdBy   String?

  transactionDate DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([marketId])
  @@index([accountId])
  @@map("account_transactions")
}

// ============================================================
// EXIT / CHEQUES / DOCUMENTS
// ============================================================

model ExitClearance {
  id String @id @default(uuid()) @db.Uuid

  marketId   String @db.Uuid
  contractId String @unique @db.Uuid
  tenantId   String @db.Uuid
  shopId     String @db.Uuid

  market   Market   @relation(fields: [marketId], references: [id])
  contract Contract @relation(fields: [contractId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  shop     Shop     @relation(fields: [shopId], references: [id])

  exitDate DateTime

  shopCondition String?

  damageCost      Decimal? @db.Decimal(12, 2)
  billsCleared    Boolean  @default(false)
  remainingAmount Decimal? @db.Decimal(12, 2)
  refundedAmount  Decimal? @db.Decimal(12, 2)

  reason     String?
  approvedBy String?

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([marketId])
  @@map("exit_clearances")
}

model Cheque {
  id String @id @default(uuid()) @db.Uuid

  marketId   String  @db.Uuid
  tenantId   String  @db.Uuid
  contractId String? @db.Uuid

  market   Market    @relation(fields: [marketId], references: [id])
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  contract Contract? @relation(fields: [contractId], references: [id])

  bankName     String
  chequeNumber String

  amount Decimal @db.Decimal(12, 2)

  issueDate DateTime
  dueDate   DateTime

  status ChequeStatus @default(PENDING)

  accountId    String? @db.Uuid
  returnReason String?
  imageUrl     String?

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([marketId])
  @@index([tenantId])
  @@map("cheques")
}

model Document {
  id String @id @default(uuid()) @db.Uuid

  marketId String @db.Uuid
  market   Market @relation(fields: [marketId], references: [id])

  entityType DocumentEntityType
  entityId   String             @db.Uuid

  fileType String
  filePath String

  uploadedBy String?

  createdAt DateTime @default(now())

  @@index([marketId])
  @@index([entityId])
  @@map("documents")
}

// ============================================================
// USERS / RBAC
// ============================================================

model User {
  id String @id @default(uuid()) @db.Uuid

  marketId String? @db.Uuid
  market   Market? @relation(fields: [marketId], references: [id])

  name     String
  username String  @unique
  email    String? @unique
  password String

  status UserStatus @default(ACTIVE)

  roles         UserRole[]
  auditLogs     AuditLog[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([marketId])
  @@map("users")
}

model Role {
  id String @id @default(uuid()) @db.Uuid

  name        String  @unique
  description String?

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())

  @@map("roles")
}

model Permission {
  id String @id @default(uuid()) @db.Uuid

  name        String  @unique
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())

  @@map("permissions")
}

model UserRole {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id String @id @default(uuid()) @db.Uuid

  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================
// AUDIT / NOTIFICATIONS
// ============================================================

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  marketId String? @db.Uuid
  userId   String? @db.Uuid

  market Market? @relation(fields: [marketId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  action    String
  tableName String
  recordId  String?

  oldValue Json?
  newValue Json?

  ipAddress  String?
  deviceInfo String?

  createdAt DateTime @default(now())

  @@index([marketId])
  @@index([userId])
  @@map("audit_logs")
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  marketId String  @db.Uuid
  userId   String? @db.Uuid

  market Market @relation(fields: [marketId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  type     String
  message  String
  priority NotificationPriority @default(NORMAL)
  isRead   Boolean              @default(false)

  referenceType String?
  referenceId   String?

  createdBy String?

  readAt     DateTime?
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([marketId])
  @@map("notifications")
}

// ============================================================
// SHAREHOLDERS / INVESTMENTS
// ============================================================

model Shareholder {
  id String @id @default(uuid()) @db.Uuid

  marketId String @db.Uuid
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String?
  phone     String?

  initialInvestment Decimal @default(0) @db.Decimal(14, 2)

  ownershipHistories    OwnershipHistory[]
  additionalInvestments AdditionalInvestment[]
  withdrawals           Withdrawal[]

  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([marketId])
  @@map("shareholders")
}

model OwnershipHistory {
  id String @id @default(uuid()) @db.Uuid

  shareholderId String      @db.Uuid
  shareholder   Shareholder @relation(fields: [shareholderId], references: [id], onDelete: Cascade)

  percentage Decimal   @db.Decimal(5, 2)
  startDate  DateTime
  endDate    DateTime?

  approvedBy String?

  createdAt DateTime @default(now())

  @@index([shareholderId])
  @@map("ownership_histories")
}

model AdditionalInvestment {
  id String @id @default(uuid()) @db.Uuid

  marketId      String @db.Uuid
  shareholderId String @db.Uuid

  market      Market      @relation(fields: [marketId], references: [id])
  shareholder Shareholder @relation(fields: [shareholderId], references: [id], onDelete: Cascade)

  amount         Decimal        @db.Decimal(14, 2)
  investmentType InvestmentType
  investmentDate DateTime

  description String?

  createdAt DateTime @default(now())

  @@index([marketId])
  @@index([shareholderId])
  @@map("additional_investments")
}

model Withdrawal {
  id String @id @default(uuid()) @db.Uuid

  marketId      String  @db.Uuid
  shareholderId String  @db.Uuid
  accountId     String? @db.Uuid

  market      Market      @relation(fields: [marketId], references: [id])
  shareholder Shareholder @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
  account     Account?    @relation(fields: [accountId], references: [id])

  amount         Decimal  @db.Decimal(14, 2)
  withdrawalDate DateTime

  source      String?
  description String?

  createdAt DateTime @default(now())

  @@index([marketId])
  @@index([shareholderId])
  @@map("withdrawals")
}
