  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  name        String @db.VarChar(100)
  keyHash     String @unique @db.VarChar(255)
  description String? @db.Text

  permissions Json?
  lastUsedIp  String? @db.VarChar(45)
  lastUsedAt  DateTime? @db.Timestamptz(6)

  expiresAt  DateTime? @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  version Int @default(1)

  @@index([userId])
  @@index([marketId])
  @@index([keyHash])
  @@index([deletedAt])
  @@map("api_keys")
}

model UserLoginAttempt {
    id String @id @db.Uuid

  userId   String? @db.Uuid
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  username String @db.VarChar(50)
  ipAddress String? @db.VarChar(45)
  userAgent String? @db.Text

  success Boolean @default(false)
  failReason String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([username, createdAt])
  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
  @@map("user_login_attempts")
}

// ============================================================
// AUDIT / ACTIVITY / NOTIFICATIONS
// ============================================================

model AuditLog {
    id String @id @db.Uuid

  marketId String? @db.Uuid
  userId   String? @db.Uuid

  market Market? @relation(fields: [marketId], references: [id], onDelete: SetNull)
  user   User?   @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  changesHistory AuditLogChange[]
  operation AuditOperation
  actionSource AuditActionSource @default(WEB)

  tableName String @db.VarChar(50)
  recordId  String? @db.Uuid
  entityType String? @db.VarChar(50)

  // FIX: Store diffs instead of full objects
  changes Json? // [{field: "status", old: "ACTIVE", new: "INACTIVE"}]

  // Legacy full objects (deprecated, kept for migration)
  oldValue Json?
  newValue Json?

  ipAddress  String? @db.VarChar(45)
  deviceInfo String? @db.Text
  requestId  String? @db.Uuid
  traceId    String? @db.Uuid
  correlationId String? @db.Uuid

  superAdminAccess Boolean @default(false)

  success      Boolean @default(true)
  errorMessage String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  // Archive fields
  isArchived Boolean @default(false)
  archivedAt DateTime? @db.Timestamptz(6)

  // Migration: ALTER TABLE audit_logs PARTITION BY RANGE (createdAt);
  @@index([marketId, createdAt])
  @@index([userId, createdAt])
  @@index([tableName, recordId])
  @@index([createdAt])
  @@index([requestId])
  @@index([traceId])
  @@index([correlationId])
  @@index([isArchived])
  @@map("audit_logs")
}

// Separate table for audit log changes to reduce storage
model AuditLogChange {
   id String @id @db.Uuid

  auditLogId String @db.Uuid
  auditLog   AuditLog @relation(fields: [auditLogId], references: [id], onDelete: Cascade)

  fieldName String @db.VarChar(50)
  oldValue  String? @db.Text
  newValue  String? @db.Text

  @@index([auditLogId])
  @@map("audit_log_changes")
}

model ActivityLog {
   id String @id @db.Uuid

  userId   String  @db.Uuid
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketId String? @db.Uuid
  market   Market? @relation(fields: [marketId], references: [id], onDelete: SetNull)

  activity  String @db.VarChar(100)
  details   Json?

  ipAddress  String? @db.VarChar(45)
  userAgent  String? @db.Text
  requestId  String? @db.Uuid
  traceId    String? @db.Uuid
  correlationId String? @db.Uuid

  duration   Int?
  success    Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  isArchived Boolean @default(false)
  archivedAt DateTime? @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([marketId, createdAt])
  @@index([activity])
  @@index([isArchived])
  @@map("activity_logs")
}

model Notification {
    id String @id @db.Uuid

  marketId String  @db.Uuid
  userId   String? @db.Uuid

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  user   User?  @relation("UserNotifications", fields: [userId], references: [id], onDelete: SetNull)

  type     NotificationType
  message  String @db.Text
  priority NotificationPriority @default(NORMAL)
  isRead   Boolean @default(false)

  referenceType NotificationReferenceType?
  referenceId   String? @db.Uuid

  createdById String? @db.Uuid

  readAt     DateTime? @db.Timestamptz(6)
  resolvedAt DateTime? @db.Timestamptz(6)
  expiresAt  DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  version Int @default(1)

  @@index([marketId, isRead, createdAt])
  @@index([userId, isRead, createdAt])
  @@index([referenceType, referenceId])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("notifications")
}

// ============================================================
// SHAREHOLDERS / INVESTMENTS
// ============================================================

model Shareholder {
    id String @id @db.Uuid

  marketId String @db.Uuid
  market   Market @relation(fields: [marketId], references: [id], onDelete: Restrict)

  firstName String @db.VarChar(100)
  lastName  String? @db.VarChar(100)
  phone     String @db.VarChar(20)

  initialInvestment Decimal @default(0) @db.Decimal(18, 2)

  ownershipHistories    OwnershipHistory[]
  additionalInvestments AdditionalInvestment[]
  withdrawals           Withdrawal[]

  description String? @db.Text

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  version Int @default(1)

  // Migration: CREATE UNIQUE INDEX shareholder_phone_active ON shareholders(phone) WHERE deleted_at IS NULL;
  @@unique([marketId, phone])
  @@index([marketId])
  @@index([deletedAt])
  @@map("shareholders")
}

model OwnershipHistory {
   id String @id @db.Uuid

  marketId      String @db.Uuid
  shareholderId String @db.Uuid
  market        Market      @relation(fields: [marketId], references: [id], onDelete: Restrict)
  shareholder   Shareholder @relation(fields: [shareholderId], references: [id], onDelete: Restrict)

  percentage Decimal @db.Decimal(5, 2)
  startDate  DateTime @db.Date
  endDate    DateTime? @db.Date

  approvedById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  version Int @default(1)

  @@unique([shareholderId, startDate])
  @@index([marketId])
  @@index([shareholderId])
  @@index([shareholderId, startDate, endDate])
  @@map("ownership_histories")
}

model AdditionalInvestment {
    id String @id @db.Uuid

  marketId      String @db.Uuid
  shareholderId String @db.Uuid

  market      Market      @relation(fields: [marketId], references: [id], onDelete: Restrict)
  shareholder Shareholder @relation(fields: [shareholderId], references: [id], onDelete: Cascade)

  amount         Decimal @db.Decimal(18, 2)
  investmentType InvestmentType
  investmentDate DateTime @db.Date

  description String? @db.Text

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  version Int @default(1)

  @@index([marketId])
  @@index([shareholderId])
  @@map("additional_investments")
}

model Withdrawal {
    id String @id @db.Uuid

  marketId      String  @db.Uuid
  shareholderId String  @db.Uuid
  accountId     String? @db.Uuid

  market      Market      @relation(fields: [marketId], references: [id], onDelete: Restrict)
  shareholder Shareholder @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
  account     Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)

  amount         Decimal @db.Decimal(18, 2)
  withdrawalDate DateTime @db.Date

  source      String? @db.VarChar(100)
  description String? @db.Text

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  version Int @default(1)

  @@index([marketId])
  @@index([shareholderId])
  @@index([accountId])
  @@map("withdrawals")
}