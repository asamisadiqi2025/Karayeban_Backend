enum UserRole {
  SUPER_ADMIN
  ADMIN
  ACCOUNTANT
  STAFF
}

enum ShopType {
  shop
  kiosk
  stall // بساط
  vendor
  office
  warehouse
}

// چهار وضعیت دقیقاً منطبق با نیازمندی: فعال، غیرفعال، خالی، کرایه‌داده‌شده.
enum ShopStatus {
  active
  inactive
  empty
  rented
}

enum ContractStatus {
  draft
  suspended
  active
  early_terminated
  expired
  cancelled
}

enum PaymentMethod {
  cash
  bank_transfer
  cheque
  online
}

enum MeterStatus {
  active
  inactive
}

enum AssetStatus {
  active
  disposed
}

enum Gender {
  male
  female
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ACTIVATE
  DEACTIVATE
  TERMINATE
  RENEW
}


// تاریخچهٔ نرخ تبدیل هر ارز به ارز پایهٔ مارکت — به‌جای یک عدد تکی روی Market که با نرخ جدید گم می‌شد.
// چند جفت ارز هم‌زمان (مثلاً AFN↔USD و AFN↔PKR) و نرخ هر روز/دوره قابل نگه‌داری است.
model ExchangeRate {
  id            String   @id @default(uuid()) @db.Uuid
  marketId      String   @map("market_id") @db.Uuid
  currencyId    String   @map("currency_id") @db.Uuid
  rateToBase    Decimal  @map("rate_to_base") @db.Decimal(18, 6)
  effectiveDate DateTime @map("effective_date") @db.Date

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  currency  Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([marketId, currencyId, effectiveDate])
  @@index([marketId])
  @@index([currencyId, effectiveDate])
  @@map("exchange_rates")
}


model ExpenseCategory {
  id       String  @id @default(uuid()) @db.Uuid
  marketId String? @map("market_id") @db.Uuid
  name     String  @db.VarChar(255)
  isActive Boolean @default(true) @map("is_active")

  market   Market?   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([marketId])
}


model Expense {
  id            String   @id @default(uuid()) @db.Uuid
  marketId      String   @map("market_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  amount        Decimal  @db.Decimal(18, 2)
  currencyId    String   @map("currency_id") @db.Uuid
  usdEquivalent Decimal? @map("usd_equivalent") @db.Decimal(18, 2)
  expenseDate   DateTime @map("expense_date") @db.Timestamptz(6)
  description   String?  @db.Text
  accountId     String   @map("account_id") @db.Uuid
  paidById      String   @map("paid_by_id") @db.Uuid
  receiptImage  String?  @map("receipt_image") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  market   Market          @relation(fields: [marketId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account  Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  currency Currency        @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  paidBy   User            @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: Restrict)

  // وقتی جایزهٔ قرعه‌کشی اهدا می‌شود، هزینه‌اش این‌جا هم به‌عنوان یک مصرف ثبت می‌شود.
  lotteryPrizes LotteryPrize[]

  @@index([marketId])
  @@index([categoryId])
  @@index([accountId])
  @@map("expenses")
}


model ElectricityMeter {
  id           String      @id @default(uuid()) @db.Uuid
  marketId     String      @map("market_id") @db.Uuid
  // شمارهٔ نمایشی کنتور — هنگام ساخت برابر shopNumber مقداردهی می‌شود (شمارهٔ کنتور = شمارهٔ دوکان).
  meterNumber  String?     @map("meter_number")
  serialNumber String? // شمارهٔ فیزیکی سخت‌افزار کنتور — مفهومی جدا از meterNumber
  // shopId «خانهٔ اصلی و ثابت» کنتور است و هنگام ادغام/تفکیک دوکان‌ها هرگز تغییر نمی‌کند؛
  // فقط status عوض می‌شود (فعال/غیرفعال). دوکان فعلاً‌فعال یک گروه از ShopGroup.primaryMeterId معلوم می‌شود.
  shopId       String?     @map("shop_id") @db.Uuid
  status       MeterStatus @default(active)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  market              Market            @relation(fields: [marketId], references: [id], onDelete: Cascade)
  shop                Shop?             @relation(fields: [shopId], references: [id], onDelete: SetNull)
  primaryForShopGroup ShopGroup?        @relation("PrimaryMeterForShopGroup")
  bills               ElectricityBill[]

  @@unique([marketId, meterNumber])
  @@index([shopId])
  @@index([status])
}

enum ElectricityBillStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELED
}

// بل برق دوره‌ای (هر دو ماه)؛ جمع‌آوری همچنان هفته‌وار و قسطی است — همان الگوی RentCharges.
// وقتی paidAmount به totalAmount برسد، سرویس status را PAID می‌کند و دوره «بسته» تلقی می‌شود.
model ElectricityBill {
  id       String  @id @default(uuid()) @db.Uuid
  marketId String  @map("market_id") @db.Uuid
  shopId   String  @map("shop_id") @db.Uuid
  meterId  String? @map("meter_id") @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid

  periodStart     DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd       DateTime @map("period_end") @db.Timestamptz(6)
  previousReading Decimal? @map("previous_reading") @db.Decimal(12, 2)
  currentReading  Decimal? @map("current_reading") @db.Decimal(12, 2)

  totalAmount     Decimal @map("total_amount") @db.Decimal(15, 2)
  paidAmount      Decimal @default(0) @map("paid_amount") @db.Decimal(15, 2)
  remainingAmount Decimal @default(0) @map("remaining_amount") @db.Decimal(15, 2)

  currency       String                @default("AFN") @db.VarChar(10)
  status         ElectricityBillStatus @default(PENDING)
  // برای بل‌هایی که از کتابچهٔ کاغذی مهاجرت شده‌اند (ن.ک. حالت پرخطر ۵ در گزارش)
  isOpeningEntry Boolean               @default(false) @map("is_opening_entry")

  notes       String? @db.Text
  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  market    Market            @relation(fields: [marketId], references: [id], onDelete: Cascade)
  shop      Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  meter     ElectricityMeter? @relation(fields: [meterId], references: [id], onDelete: SetNull)
  tenant    Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdBy User?             @relation("ElectricityBillCreator", fields: [createdById], references: [id], onDelete: SetNull)

  allocations ElectricityPaymentAllocation[]

  @@index([marketId])
  @@index([shopId])
  @@index([tenantId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@map("electricity_bills")
}

// خلاصهٔ زندهٔ بدهی برق هر مستأجر — دقیقاً هم‌الگو با RentDebt.
model ElectricityDebt {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  totalDebt         Decimal   @default(0) @map("total_debt") @db.Decimal(15, 2)
  lastBillAmount    Decimal   @default(0) @map("last_bill_amount") @db.Decimal(15, 2)
  lastPaymentAmount Decimal   @default(0) @map("last_payment_amount") @db.Decimal(15, 2)
  lastBillDate      DateTime? @map("last_bill_date") @db.Timestamptz(6)
  lastPaymentDate   DateTime? @map("last_payment_date") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("electricity_debts")
}

// یک پرداخت فیزیکی (یک رسید) برای برق؛ می‌تواند بین چند بل تقسیم شود (ن.ک. ElectricityPaymentAllocation) —
// دقیقاً همان قانونی که برای کرایه خواستید: هر پرداخت اول بدهی قدیمی‌تر را می‌پوشاند.
model ElectricityPayment {
  id            String        @id @default(uuid()) @db.Uuid
  marketId      String        @map("market_id") @db.Uuid
  shopId        String        @map("shop_id") @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  amount        Decimal       @db.Decimal(15, 2)
  currency      String        @default("AFN") @db.VarChar(10)
  paymentDate   DateTime      @map("payment_date") @db.Timestamptz(6)
  paymentMethod PaymentMethod @map("payment_method")
  accountId     String?       @map("account_id") @db.Uuid
  collectedById String?       @map("collected_by_id") @db.Uuid
  receiptNumber String?       @map("receipt_number") @db.VarChar(100)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  market      Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  collectedBy User?    @relation("ElectricityCollectedBy", fields: [collectedById], references: [id], onDelete: SetNull)

  allocations ElectricityPaymentAllocation[]

  @@index([marketId])
  @@index([shopId])
  @@index([tenantId])
  @@map("electricity_payments")
}

model ElectricityPaymentAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  billId    String   @map("bill_id") @db.Uuid
  amount    Decimal  @db.Decimal(15, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment ElectricityPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill    ElectricityBill    @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([paymentId, billId])
  @@index([paymentId])
  @@index([billId])
  @@map("electricity_payment_allocations")
}

model OverdueDebt {
  id       String   @id @default(uuid()) @db.Uuid
  amount   Decimal?
  shopId   String?  @map("shop_id") @db.Uuid
  shop     Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)
  tenantId String?  @map("tenant_id") @db.Uuid
  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
}

// مدل ShareholderTransaction به prisma/models/shareholder.prisma منتقل شد
// (کنار Shareholder و ShareholderEquity، چون دیگر یک ردیف اسکلتی نیست).

// ==========================================
// ✅ اصلاح‌شده: اضافه کردن رابطه با Asset
// ==========================================
model DepreciationEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  assetId            String   @map("asset_id") @db.Uuid // 👈 اضافه شد
  year               Int
  depreciationAmount Decimal  @map("depreciation_amount") @db.Decimal(12, 2)
  bookValueBefore    Decimal  @map("book_value_before") @db.Decimal(12, 2)
  bookValueAfter     Decimal  @map("book_value_after") @db.Decimal(12, 2)
  appliedAt          DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)
  appliedById        String?  @map("applied_by_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // 👇 رابطه با Asset (کلید اصلی)
  asset     Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  appliedBy User? @relation("DepreciationAppliedBy", fields: [appliedById], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@map("depreciation_events")
}


model Floor {
  id          String   @id @default(uuid()) @db.Uuid
  marketId    String   @map("market_id") @db.Uuid
  floorNumber Int      @map("floor_number")
  name        String?  @db.VarChar(100)
  details     String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  shops  Shop[]

  @@unique([marketId, floorNumber])
  @@index([marketId])
  @@map("floors")
}


model Guarantor {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(150)
  contact   String?  @db.VarChar(30)
  idNumber  String?  @map("id_number") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("guarantors")
}


// ============================
// قرعه‌کشی/تشویقی — هر خرید بالای یک سقف مبلغ (مثلاً ۵۰۰ افغانی) یک قرعه صادر می‌کند.
// خریدار معمولاً مشتری است، نه مستاجر/دوکاندار؛ چون در سیستم ثبت‌نام ندارد،
// نام و تماسش مستقیم روی ردیف LotteryEntry نگه داشته می‌شود (نه FK به Tenant).
// ============================

enum LotteryDrawStatus {
  OPEN // هنوز قرعه می‌گیرد
  CLOSED // مهلت ثبت تمام شده، هنوز قرعه‌کشی نشده
  DRAWN // برنده(ها) مشخص شده‌اند
}

model LotteryDraw {
  id                    String            @id @default(uuid()) @db.Uuid
  marketId              String            @map("market_id") @db.Uuid
  title                 String?           @db.VarChar(150)
  periodStart           DateTime          @map("period_start") @db.Timestamptz(6)
  periodEnd             DateTime          @map("period_end") @db.Timestamptz(6)
  ticketThresholdAmount Decimal           @map("ticket_threshold_amount") @db.Decimal(15, 2)
  status                LotteryDrawStatus @default(OPEN)
  drawnAt               DateTime?         @map("drawn_at") @db.Timestamptz(6)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  market  Market         @relation(fields: [marketId], references: [id], onDelete: Cascade)
  entries LotteryEntry[]
  prizes  LotteryPrize[]

  @@index([marketId])
  @@map("lottery_draws")
}

model LotteryEntry {
  id     String  @id @default(uuid()) @db.Uuid
  drawId String  @map("draw_id") @db.Uuid
  shopId String? @map("shop_id") @db.Uuid

  buyerName    String  @map("buyer_name") @db.VarChar(150)
  buyerContact String? @map("buyer_contact") @db.VarChar(30)

  purchaseAmount Decimal @map("purchase_amount") @db.Decimal(15, 2)
  ticketCount    Int     @map("ticket_count")
  ticketNumber   String? @map("ticket_number") @db.VarChar(50)

  issuedAt   DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  issuedById String?  @map("issued_by_id") @db.Uuid

  draw     LotteryDraw @relation(fields: [drawId], references: [id], onDelete: Cascade)
  shop     Shop?       @relation(fields: [shopId], references: [id], onDelete: SetNull)
  issuedBy User?       @relation(fields: [issuedById], references: [id], onDelete: SetNull)

  wonPrizes LotteryPrize[]

  @@index([drawId])
  @@index([shopId])
  @@map("lottery_entries")
}

model LotteryPrize {
  id            String  @id @default(uuid()) @db.Uuid
  drawId        String  @map("draw_id") @db.Uuid
  winnerEntryId String? @map("winner_entry_id") @db.Uuid

  description String    @db.Text
  cost        Decimal   @db.Decimal(15, 2)
  currency    String    @default("AFN") @db.VarChar(10)
  awardedAt   DateTime? @map("awarded_at") @db.Timestamptz(6)

  // پس از اهدا، هزینه‌اش به‌عنوان یک مصرف هم ثبت می‌شود.
  expenseId String? @map("expense_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  draw        LotteryDraw   @relation(fields: [drawId], references: [id], onDelete: Cascade)
  winnerEntry LotteryEntry? @relation(fields: [winnerEntryId], references: [id], onDelete: SetNull)
  expense     Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([drawId])
  @@map("lottery_prizes")
}


model Market {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(200)
  logo            String?  @db.Text
  address         String?  @db.Text
  contacts        Json?    @default("[]")
  details         String?  @db.Text
  // ارز پایه از فهرست Currency انتخاب می‌شود (نه یک رشتهٔ آزاد)؛ نرخ‌های ارز در ExchangeRate با تاریخ نگه داشته می‌شوند.
  baseCurrencyId  String?  @map("base_currency_id") @db.Uuid
  isSetupComplete Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @db.Timestamp(6)

  baseCurrency Currency? @relation(fields: [baseCurrencyId], references: [id], onDelete: SetNull)

  customRoles             CustomRole[]
  users                   User[]
  accounts                Account[]
  auditLogs               AuditLog[]
  contracts               Contract[]
  expenses                Expense[]
  floors                  Floor[]
  miscellaneousIncome     MiscellaneousIncome[]
  openingBalances         OpeningBalance[]
  rentCharges             RentCharges[]
  rentPayments            RentPayment[]
  shopGroups              ShopGroup[]
  shops                   Shop[]
  tenants                 Tenant[]
  assets                  Asset[]
  shareholders            Shareholder[]
  shareholderTransactions ShareholderTransaction[]
  accountTransfers        AccountTransfer[]
  electricityBills        ElectricityBill[]
  electricityPayments     ElectricityPayment[]
  electricityMeters       ElectricityMeter[]
  collateralItems         CollateralItem[]
  lotteryDraws            LotteryDraw[]
  exchangeRates           ExchangeRate[]
  expenseCategories       ExpenseCategory[]

  @@map("markets")
}


