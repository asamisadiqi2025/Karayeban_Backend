// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =========================================
// PART 1 : CORE TABLES
// =========================================

model Floor {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(100)
  floorPosition String?  @map("floor_position") @db.VarChar(100)
  description   String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  shops Shop[]

  @@map("floors")
}

model ShopCategory {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  shops Shop[]

  @@map("shop_categories")
}

model Shop {
  id                     String  @id @default(uuid()) @db.Uuid
  shopCode               String  @unique @map("shop_code") @db.VarChar(50)
  floorId                String? @map("floor_id") @db.Uuid
  categoryId             String? @map("category_id") @db.Uuid
  shopNumber             String? @map("shop_number") @db.VarChar(50)
  rentAmount             Decimal @default(0) @map("rent_amount") @db.Decimal(12, 2)
  areaInSquareMeters     Decimal @default(0) @map("area_in_square_meters") @db.Decimal(10, 2)
  electricityMeterNumber String? @map("electricity_meter_number") @db.VarChar(100)
  waterMeterNumber       String? @map("water_meter_number") @db.VarChar(100)
  description            String?
  status                 String  @default("empty") @db.VarChar(30)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  floor          Floor?          @relation(fields: [floorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  category       ShopCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  contracts      Contract[]
  rentPayments   RentPayment[]
  utilityBills   UtilityBill[]
  exitClearances ExitClearance[]

  @@index([floorId], map: "idx_shop_floor")
  @@index([categoryId], map: "idx_shop_category")
  @@index([status], map: "idx_shop_status")
  @@map("shops")
}

model Tenant {
  id             String  @id @default(uuid()) @db.Uuid
  fullName       String  @map("full_name") @db.VarChar(150)
  tazkiraNumber  String? @unique @map("tazkira_number") @db.VarChar(100)
  phone          String? @db.VarChar(50)
  phone2         String? @db.VarChar(50)
  emergencyPhone String? @map("emergency_phone") @db.VarChar(50)
  address        String?
  businessName   String? @map("business_name") @db.VarChar(150)
  gender         String? @db.VarChar(20)
  status         String  @default("active") @db.VarChar(30)
  debtStatus     String  @default("paid") @map("debt_status") @db.VarChar(30)
  photo          String?
  description    String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  guarantors     Guarantor[]
  contracts      Contract[]
  exitClearances ExitClearance[]
  cheques        Cheque[]

  @@index([phone], map: "idx_tenant_phone")
  @@index([tazkiraNumber], map: "idx_tenant_tazkira")
  @@map("tenants")
}

model Guarantor {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  fullName      String  @map("full_name") @db.VarChar(150)
  phone         String? @db.VarChar(50)
  address       String?
  tazkiraCopy   String? @map("tazkira_copy")
  guarantorForm String? @map("guarantor_form")
  description   String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("guarantors")
}

model Contract {
  id                 String    @id @default(uuid()) @db.Uuid
  contractNumber     String    @unique @map("contract_number") @db.VarChar(100)
  shopId             String    @map("shop_id") @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  previousContractId String?   @map("previous_contract_id") @db.Uuid
  startDate          DateTime  @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  monthlyRent        Decimal   @default(0) @map("monthly_rent") @db.Decimal(12, 2)
  depositAmount      Decimal   @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  status             String    @default("active") @db.VarChar(30)
  renewCount         Int       @default(0) @map("renew_count")
  nextContractDate   DateTime? @map("next_contract_date") @db.Date
  signedAt           DateTime? @map("signed_at")
  approvedBy         String?   @map("approved_by") @db.Uuid
  terminatedBy       String?   @map("terminated_by") @db.Uuid
  terminationReason  String?   @map("termination_reason")
  description        String?

  createdAt DateTime @default(now()) @map("created_at")

  shop             Shop       @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  previousContract Contract?  @relation("ContractRenewal", fields: [previousContractId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  renewedContracts Contract[] @relation("ContractRenewal")

  contractTerms  ContractTerm[]
  rentPayments   RentPayment[]
  exitClearances ExitClearance[]
  cheques        Cheque[]

  @@index([shopId], map: "idx_contract_shop")
  @@index([tenantId], map: "idx_contract_tenant")
  @@index([status], map: "idx_contract_status")
  @@index([contractNumber], map: "idx_contract_number")
  @@map("contracts")
}

model ContractTerm {
  id                    String  @id @default(uuid()) @db.Uuid
  contractId            String  @map("contract_id") @db.Uuid
  workingHours          String? @map("working_hours") @db.VarChar(100)
  monthlyOffDays        Int     @default(0) @map("monthly_off_days")
  terminationConditions String? @map("termination_conditions")
  specialConditions     String? @map("special_conditions")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("contract_terms")
}

// =========================================
// PART 2 : FINANCIAL & OPERATIONS TABLES
// =========================================

model RentPayment {
  id            String   @id @default(uuid()) @db.Uuid
  shopId        String   @map("shop_id") @db.Uuid
  contractId    String   @map("contract_id") @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
  paymentDate   DateTime @map("payment_date") @db.Date
  paymentMethod String?  @map("payment_method") @db.VarChar(50)
  status        String   @default("paid") @db.VarChar(30)
  year          Int?
  lateFee       Decimal  @default(0) @map("late_fee") @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  accountId     String?  @map("account_id") @db.Uuid
  receivedBy    String?  @map("received_by") @db.Uuid
  description   String?

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  account  Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  receiver User?    @relation("RentPaymentReceiver", fields: [receivedBy], references: [id], onDelete: SetNull)

  @@index([contractId], map: "idx_payment_contract")
  @@index([paymentDate], map: "idx_payment_date")
  @@index([status], map: "idx_payment_status")
  @@map("rent_payments")
}

model UtilityBill {
  id            String    @id @default(uuid()) @db.Uuid
  shopId        String    @map("shop_id") @db.Uuid
  serviceType   String    @map("service_type") @db.VarChar(50)
  previousMeter String?   @map("previous_meter") @db.VarChar(100)
  currentMeter  String?   @map("current_meter") @db.VarChar(100)
  rate          Decimal   @default(0) @db.Decimal(10, 2)
  amount        Decimal   @default(0) @db.Decimal(12, 2)
  billMonth     Int?      @map("bill_month")
  billYear      Int?      @map("bill_year")
  dueDate       DateTime? @map("due_date") @db.Date
  status        String    @default("unpaid") @db.VarChar(30)
  description   String?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId], map: "idx_bill_shop")
  @@map("utility_bills")
}

model ExpenseCategory {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  description String?

  marketExpenses MarketExpense[]

  @@map("expense_categories")
}

model Employee {
  id       String  @id @default(uuid()) @db.Uuid
  fullName String  @map("full_name") @db.VarChar(150)
  phone    String? @db.VarChar(50)
  jobTitle String? @map("job_title") @db.VarChar(100)
  salary   Decimal @default(0) @db.Decimal(12, 2)
  status   String  @default("active") @db.VarChar(30)

  marketExpenses MarketExpense[]

  @@map("employees")
}

model MarketExpense {
  id          String   @id @default(uuid()) @db.Uuid
  expenseDate DateTime @map("expense_date") @db.Date
  categoryId  String?  @map("category_id") @db.Uuid
  employeeId  String?  @map("employee_id") @db.Uuid
  accountId   String?  @map("account_id") @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  createdBy   String?  @map("created_by") @db.Uuid

  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  employee Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  account  Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  creator  User?            @relation("MarketExpenseCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([expenseDate], map: "idx_expense_date")
  @@map("market_expenses")
}

model ExitClearance {
  id                   String   @id @default(uuid()) @db.Uuid
  contractId           String   @map("contract_id") @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  shopId               String   @map("shop_id") @db.Uuid
  exitDate             DateTime @map("exit_date") @db.Date
  shopCondition        String?  @map("shop_condition")
  damageCost           Decimal  @default(0) @map("damage_cost") @db.Decimal(12, 2)
  billSettlementStatus String   @default("pending") @map("bill_settlement_status") @db.VarChar(50)
  remainingAmount      Decimal  @default(0) @map("remaining_amount") @db.Decimal(12, 2)
  refundAmount         Decimal  @default(0) @map("refund_amount") @db.Decimal(12, 2)
  reason               String?
  approvedBy           String?  @map("approved_by") @db.Uuid
  description          String?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@map("exit_clearances")
}

model MiscellaneousIncome {
  id           String   @id @default(uuid()) @db.Uuid
  source       String   @db.VarChar(150)
  amount       Decimal  @db.Decimal(12, 2)
  receivedDate DateTime @map("received_date") @db.Date
  accountId    String?  @map("account_id") @db.Uuid
  description  String?

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@map("miscellaneous_income")
}

// =========================================
// PART 3 : ACCOUNTING & DOCUMENT TABLES
// =========================================

model Account {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(150)
  type        String  @db.VarChar(50) // cash / bank / other
  currency    String  @default("AFN") @db.VarChar(20)
  description String?

  rentPayments         RentPayment[]
  marketExpenses       MarketExpense[]
  miscellaneousIncomes MiscellaneousIncome[]
  accountTransactions  AccountTransaction[]
  cheques              Cheque[]
  withdrawals          Withdrawal[]

  @@map("accounts")
}

model AccountTransaction {
  id                      String   @id @default(uuid()) @db.Uuid
  accountId               String   @map("account_id") @db.Uuid
  type                    String   @db.VarChar(10) // credit / debit
  amount                  Decimal  @db.Decimal(12, 2)
  referenceType           String?  @map("reference_type") @db.VarChar(100)
  referenceId             String?  @map("reference_id")
  description             String?
  createdAt               DateTime @default(now()) @map("created_at")
  transactionDate         DateTime @default(now()) @map("transaction_date")
  createdBy               String?  @map("created_by") @db.Uuid
  balanceAfterTransaction Decimal? @map("balance_after_transaction") @db.Decimal(12, 2)

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  creator User?   @relation("AccountTransactionCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([accountId], map: "idx_transaction_account")
  @@index([referenceType, referenceId], map: "idx_transaction_reference")
  @@index([transactionDate], map: "idx_transaction_date")
  @@map("account_transactions")
}

model Cheque {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String?   @map("tenant_id") @db.Uuid
  contractId   String?   @map("contract_id") @db.Uuid
  bankName     String?   @map("bank_name") @db.VarChar(150)
  chequeNumber String?   @map("cheque_number") @db.VarChar(100)
  amount       Decimal   @db.Decimal(12, 2)
  issueDate    DateTime? @map("issue_date") @db.Date
  dueDate      DateTime? @map("due_date") @db.Date
  status       String    @default("pending") @db.VarChar(30)
  image        String?
  accountId    String?   @map("account_id") @db.Uuid
  bounceReason String?   @map("bounce_reason")
  description  String?

  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  account  Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@map("cheques")
}

model Document {
  id             String   @id @default(uuid()) @db.Uuid
  referenceTable String   @map("reference_table") @db.VarChar(100)
  referenceId    String   @map("reference_id")
  fileType       String?  @map("file_type") @db.VarChar(100)
  filePath       String   @map("file_path")
  uploadedBy     String?  @map("uploaded_by") @db.Uuid
  uploadedAt     DateTime @default(now()) @map("uploaded_at")

  uploader User? @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([referenceTable, referenceId], map: "idx_document_reference")
  @@map("documents")
}

// =========================================
// PART 4 : USERS, SECURITY & OWNERSHIP
// =========================================

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  username  String   @unique @db.VarChar(100)
  email     String?  @unique @db.VarChar(150)
  password  String
  status    String   @default("active") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at")

  userRoles             UserRole[]
  rentPaymentsReceived  RentPayment[]        @relation("RentPaymentReceiver")
  marketExpensesCreated MarketExpense[]      @relation("MarketExpenseCreator")
  accountTransactions   AccountTransaction[] @relation("AccountTransactionCreator")
  documentsUploaded     Document[]           @relation("DocumentUploader")
  auditLogs             AuditLog[]
  notificationsCreated  Notification[]       @relation("NotificationCreator")

  @@map("users")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(100)
  description String?

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(100)
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Shareholder {
  id          String  @id @default(uuid()) @db.Uuid
  firstName   String  @map("first_name") @db.VarChar(100)
  lastName    String? @map("last_name") @db.VarChar(100)
  phone       String? @db.VarChar(50)
  description String?

  ownershipHistories    OwnershipHistory[]
  additionalInvestments AdditionalInvestment[]
  withdrawals           Withdrawal[]

  @@map("shareholders")
}

model OwnershipHistory {
  id            String    @id @default(uuid()) @db.Uuid
  shareholderId String    @map("shareholder_id") @db.Uuid
  percentage    Decimal   @db.Decimal(5, 2)
  startDate     DateTime  @map("start_date") @db.Date
  endDate       DateTime? @map("end_date") @db.Date

  shareholder Shareholder @relation(fields: [shareholderId], references: [id], onDelete: Cascade)

  @@map("ownership_histories")
}

model AdditionalInvestment {
  id             String   @id @default(uuid()) @db.Uuid
  shareholderId  String   @map("shareholder_id") @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  investmentDate DateTime @map("investment_date") @db.Date
  type           String?  @db.VarChar(50)
  description    String?

  shareholder Shareholder @relation(fields: [shareholderId], references: [id], onDelete: Cascade)

  @@map("additional_investments")
}

model Withdrawal {
  id             String   @id @default(uuid()) @db.Uuid
  shareholderId  String   @map("shareholder_id") @db.Uuid
  accountId      String?  @map("account_id") @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  withdrawalDate DateTime @map("withdrawal_date") @db.Date
  source         String?
  description    String?

  shareholder Shareholder @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
  account     Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@map("withdrawals")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(100)
  tableName String   @map("table_name") @db.VarChar(100)
  recordId  String?  @map("record_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address") @db.VarChar(100)
  device    String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId], map: "idx_audit_user")
  @@map("audit_logs")
}

model Notification {
  id            String    @id @default(uuid()) @db.Uuid
  type          String    @db.VarChar(100)
  message       String
  isRead        Boolean   @default(false) @map("is_read")
  priority      String    @default("normal") @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at")
  readAt        DateTime? @map("read_at")
  createdBy     String?   @map("created_by") @db.Uuid
  resolvedAt    DateTime? @map("resolved_at")
  referenceType String?   @map("reference_type") @db.VarChar(100)
  referenceId   String?   @map("reference_id")

  creator User? @relation("NotificationCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([isRead], map: "idx_notification_status")
  @@map("notifications")
}
