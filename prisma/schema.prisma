// ============================
// مدل RentCharges - فاکتور/بدهکاری اجاره
// ============================

enum RentChargeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELED
}

model RentCharges {
  id         String @id @default(uuid()) @db.Uuid
  marketId   String @map("market_id") @db.Uuid
  contractId String @map("contract_id") @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  shopId     String @map("shop_id") @db.Uuid

  periodStart DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime @map("period_end") @db.Timestamptz(6)
  days        Int
  dailyRate   Decimal  @map("daily_rate") @db.Decimal(15, 2)

  // ========== ✅ ستون‌های محاسباتی (بدون @dbgenerated) ==========
  // این مقادیر را در کد NestJS محاسبه کنید
  grossAmount     Decimal @default(0) @map("gross_amount") @db.Decimal(15, 2)
  discountAmount  Decimal @default(0) @map("discount_amount") @db.Decimal(15, 2)
  netAmount       Decimal @default(0) @map("net_amount") @db.Decimal(15, 2)
  paidAmount      Decimal @default(0) @map("paid_amount") @db.Decimal(15, 2)
  remainingAmount Decimal @default(0) @map("remaining_amount") @db.Decimal(15, 2)
  // ============================================================

  currencyId String           @map("currency_id") @db.Uuid
  status     RentChargeStatus @default(PENDING)

  accountId   String? @map("account_id") @db.Uuid
  createdById String? @map("created_by_id") @db.Uuid
  notes       String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  contract  Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  currency  Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("RentChargeCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // یک پرداخت می‌تواند بین چند فاکتور/ماه تقسیم شود؛ منبع حقیقت تخصیص RentPaymentAllocation است.
  allocations RentPaymentAllocation[]

  @@index([marketId])
  @@index([contractId])
  @@index([tenantId])
  @@index([shopId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@map("rent_charges")
}


// ============================
// مدل RentDebt - خلاصه وضعیت بدهی هر مستأجر
// ============================

enum DebtStatus {
  CLEAN // بدهی صفر یا مثبت (بستانکار)
  LOW // بدهی کمتر از یک ماه
  MEDIUM // بدهی ۱ تا ۳ ماه
  HIGH // بدهی بیش از ۳ ماه
  CRITICAL // بدهی بیش از ۶ ماه یا دارای شکایت
}

model RentDebt {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  // مبالغ کلی
  totalDebt         Decimal @default(0) @map("total_debt") @db.Decimal(18, 2)
  overdueDebt       Decimal @default(0) @map("overdue_debt") @db.Decimal(18, 2)
  lastChargeAmount  Decimal @default(0) @map("last_charge_amount") @db.Decimal(18, 2)
  lastPaymentAmount Decimal @default(0) @map("last_payment_amount") @db.Decimal(18, 2)

  // تاریخ‌های آخرین رویدادها
  lastChargeDate  DateTime? @map("last_charge_date") @db.Timestamptz(6)
  lastPaymentDate DateTime? @map("last_payment_date") @db.Timestamptz(6)

  // وضعیت کلی
  status    DebtStatus @default(CLEAN)
  riskScore Int?       @map("risk_score") // امتیاز ریسک (مثلاً ۱ تا ۱۰۰)

  // اطلاعات تکمیلی
  notes     String?  @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ارتباط با مستأجر
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // ایندکس‌ها
  @@index([tenantId])
  @@index([status])
  @@index([updatedAt])
  @@map("rent_debts")
}


model RentPayment {
  id            String        @id @default(uuid()) @db.Uuid
  marketId      String        @map("market_id") @db.Uuid
  contractId    String        @map("contract_id") @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  shopId        String        @map("shop_id") @db.Uuid
  // month/year بر مبنای تقویم هجری‌شمسی‌اند (month: 1=حمل ... 12=حوت، year: سال شمسی)، نه میلادی.
  month         Int
  year          Int
  amount        Decimal       @db.Decimal(18, 2)
  currencyId    String        @map("currency_id") @db.Uuid
  usdEquivalent Decimal?      @map("usd_equivalent") @db.Decimal(18, 2)
  paymentDate   DateTime      @map("payment_date") @db.Timestamptz(6)
  paymentMethod PaymentMethod @map("payment_method")
  accountId     String        @map("account_id") @db.Uuid
  collectedById String        @map("collected_by_id") @db.Uuid
  notes         String?       @db.Text
  isPartial     Boolean       @default(false) @map("is_partial")
  receiptNumber String?       @map("receipt_number") @db.VarChar(100)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  market      Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  currency    Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  collectedBy User     @relation("RentCollectedBy", fields: [collectedById], references: [id], onDelete: Restrict)

  // این پرداخت (یک رسید فیزیکی واحد) می‌تواند بین چند فاکتور/ماه تقسیم شود —
  // مثلاً ۱۰۰۰ افغانی که بخشی بدهی ماه قبل و بخشی ماه جاری را می‌پوشاند.
  allocations RentPaymentAllocation[]

  @@index([marketId])
  @@index([contractId])
  @@index([tenantId])
  @@index([shopId])
  @@index([year, month])
  @@map("rent_payments")
}

// تخصیص یک پرداخت به یک یا چند فاکتور کرایه (چندبه‌چند).
// سرویس هنگام ثبت پرداخت، مبلغ را ابتدا به قدیمی‌ترین فاکتور بازِ مستاجر (بر اساس periodStart) تخصیص می‌دهد.
model RentPaymentAllocation {
  id           String   @id @default(uuid()) @db.Uuid
  paymentId    String   @map("payment_id") @db.Uuid
  rentChargeId String   @map("rent_charge_id") @db.Uuid
  amount       Decimal  @db.Decimal(18, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment    RentPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  rentCharge RentCharges @relation(fields: [rentChargeId], references: [id], onDelete: Restrict)

  @@unique([paymentId, rentChargeId])
  @@index([paymentId])
  @@index([rentChargeId])
  @@map("rent_payment_allocations")
}


// ============================
// سهام‌داران مارکت — برداشت/واریز از هر بانک + درصد سهم تاریخچه‌دار
// ============================

model Shareholder {
  id        String   @id @default(uuid()) @db.Uuid
  marketId  String   @map("market_id") @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(150)
  contact   String?  @db.VarChar(30)
  idNumber  String?  @map("id_number") @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  market        Market                   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  equityHistory ShareholderEquity[]
  transactions  ShareholderTransaction[]

  @@index([marketId])
  @@map("shareholders")
}

// درصد سهم هر سهام‌دار در طول زمان — هر بار که سهم خرید/فروخت یک ردیف جدید ثبت می‌شود
// (نه آپدیت روی جای قبلی)، تا تاریخچهٔ کامل مالکیت قابل بازسازی بماند.
// درصد «فعلی» = آخرین ردیف بر اساس effectiveFrom برای آن سهام‌دار.
model ShareholderEquity {
  id            String   @id @default(uuid()) @db.Uuid
  shareholderId String   @map("shareholder_id") @db.Uuid
  percentage    Decimal  @db.Decimal(5, 2)
  effectiveFrom DateTime @map("effective_from") @db.Date
  notes         String?  @db.Text
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shareholder Shareholder @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([shareholderId, effectiveFrom])
  @@map("shareholder_equity_history")
}

enum ShareholderTransactionType {
  DEPOSIT
  WITHDRAWAL
}

model ShareholderTransaction {
  id              String                     @id @default(uuid()) @db.Uuid
  marketId        String                     @map("market_id") @db.Uuid
  shareholderId   String                     @map("shareholder_id") @db.Uuid
  accountId       String                     @map("account_id") @db.Uuid
  type            ShareholderTransactionType
  amount          Decimal                    @db.Decimal(18, 2)
  transactionDate DateTime                   @map("transaction_date") @db.Timestamptz(6)
  receiptNumber   String?                    @map("receipt_number") @db.VarChar(100)
  details         String?                    @db.Text
  createdById     String?                    @map("created_by_id") @db.Uuid
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  market      Market      @relation(fields: [marketId], references: [id], onDelete: Cascade)
  shareholder Shareholder @relation(fields: [shareholderId], references: [id], onDelete: Restrict)
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdBy   User?       @relation("ShareholderTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([marketId])
  @@index([shareholderId])
  @@index([accountId])
  @@map("shareholder_transactions")
}


model ShopGroup {
  id             String    @id @default(uuid()) @db.Uuid
  marketId       String    @map("market_id") @db.Uuid
  primaryMeterId String?   @map("primary_meter_id") @db.Uuid
  // قراردادِ واحدی که هنگام ادغام روی همهٔ دوکان‌های عضو این گروه بسته می‌شود (ن.ک. Contract/ContractShop).
  contractId     String?   @map("contract_id") @db.Uuid
  startedAt      DateTime  @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(6)

  market       Market            @relation(fields: [marketId], references: [id], onDelete: Cascade)
  primaryMeter ElectricityMeter? @relation("PrimaryMeterForShopGroup", fields: [primaryMeterId], references: [id], onDelete: SetNull)
  contract     Contract?         @relation(fields: [contractId], references: [id], onDelete: SetNull)
  members      ShopGroupMember[]

  @@unique([primaryMeterId])
  @@index([marketId])
  @@index([contractId])
  @@map("shop_groups")
}

model ShopGroupMember {
  id       String    @id @default(uuid()) @db.Uuid
  groupId  String    @map("group_id") @db.Uuid
  shopId   String    @map("shop_id") @db.Uuid
  joinedAt DateTime  @map("joined_at") @db.Timestamptz(6)
  leftAt   DateTime? @map("left_at") @db.Timestamptz(6)

  group ShopGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  shop  Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@unique([groupId, shopId])
  @@index([shopId])
  @@map("shop_group_members")
}


model Shop {
  id         String     @id @default(uuid()) @db.Uuid
  marketId   String     @map("market_id") @db.Uuid
  floorId    String?    @map("floor_id") @db.Uuid
  shopNumber String     @map("shop_number") @db.VarChar(50)
  area       Decimal?   @db.Decimal(12, 2)
  location   String?    @db.VarChar(255)
  type       ShopType   @default(shop)
  status     ShopStatus @default(empty)
  details    String?    @db.Text

  currentContractId String? @unique @map("current_contract_id") @db.Uuid
  currentTenantId   String? @map("current_tenant_id") @db.Uuid

  // isActive یعنی «آیا این دوکان در سیستم فعال/آرشیو نشده» (حذف نرم) — بعد جدا از status
  // که وضعیت اشغال روزمره (فعال/غیرفعال/خالی/کرایه‌داده‌شده) را نشان می‌دهد.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  floor  Floor? @relation(fields: [floorId], references: [id], onDelete: SetNull)

  currentContract Contract? @relation("CurrentShopContract", fields: [currentContractId], references: [id], onDelete: SetNull)
  currentTenant   Tenant?   @relation(fields: [currentTenantId], references: [id], onDelete: SetNull)

  contracts           Contract[]           @relation("ContractPrimaryShop")
  contractShops       ContractShop[]
  rentPayments        RentPayment[]
  rentCharges         RentCharges[]
  electricityMeters   ElectricityMeter[]
  electricityBills    ElectricityBill[]
  electricityPayments ElectricityPayment[]
  shopGroupMembers    ShopGroupMember[]
  overdueDebts        OverdueDebt[]
  lotteryEntries      LotteryEntry[]

  @@unique([marketId, shopNumber])
  @@index([marketId])
  @@index([floorId])
  @@map("shops")
}


model Tenant {
  id              String   @id @default(uuid()) @db.Uuid
  marketId        String   @map("market_id") @db.Uuid
  fullName        String   @map("full_name") @db.VarChar(150)
  fatherName      String?  @map("father_name") @db.VarChar(100)
  grandfatherName String?  @map("grandfather_name") @db.VarChar(100)
  idNumber        String?  @map("id_number") @db.VarChar(50)
  contact         String?  @db.VarChar(30)
  gender          Gender?
  details         String?  @db.Text
  photo           String?  @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  market       Market        @relation(fields: [marketId], references: [id], onDelete: Cascade)
  guarantors   Guarantor[]
  contracts    Contract[]
  rentCharges  RentCharges[]
  rentPayments RentPayment[]
  rentDebt     RentDebt?
  overdueDebts OverdueDebt[]
  shops        Shop[]

  electricityBills    ElectricityBill[]
  electricityPayments ElectricityPayment[]
  electricityDebt     ElectricityDebt?
  collateralItems     CollateralItem[]

  @@index([marketId])
  @@index([idNumber])
  @@map("tenants")
}


model User {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(150)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(STAFF)
  customRoleId String?  @map("custom_role_id") @db.Uuid
  marketId     String?  @map("market_id") @db.Uuid

  fatherName      String? @map("father_name") @db.VarChar(100)
  grandfatherName String? @map("grandfather_name") @db.VarChar(100)
  phone           String? @db.VarChar(30)
  tazkiraNumber   String? @unique @map("tazkira_number") @db.VarChar(50)
  address         String? @db.Text
  profilePhoto    String? @map("profile_photo") @db.Text

  extraPermissions  Json? @map("extra_permissions")
  deniedPermissions Json? @map("denied_permissions")

  isSuperAdmin Boolean   @default(false) @map("is_super_admin")
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  market     Market?     @relation(fields: [marketId], references: [id], onDelete: SetNull)
  customRole CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  refreshTokens RefreshToken[]

  terminatedContracts          Contract[]               @relation("ContractTerminatedBy")
  collectedRentPayments        RentPayment[]            @relation("RentCollectedBy")
  createdRentCharges           RentCharges[]            @relation("RentChargeCreator")
  changedContractStatuses      ContractStatusHistory[]  @relation("ContractStatusChangedBy")
  paidExpenses                 Expense[]                @relation("ExpensePaidBy")
  depreciationEvents           DepreciationEvent[]      @relation("DepreciationAppliedBy")
  shareholderTransactions      ShareholderTransaction[] @relation("ShareholderTransactionCreatedBy")
  shareholderEquityChanges     ShareholderEquity[]
  accountTransfers             AccountTransfer[]
  openingBalances              OpeningBalance[]
  createdElectricityBills      ElectricityBill[]        @relation("ElectricityBillCreator")
  collectedElectricityPayments ElectricityPayment[]     @relation("ElectricityCollectedBy")
  createdCollateralItems       CollateralItem[]
  issuedLotteryEntries         LotteryEntry[]
  approvedSettlements          ContractSettlement[]
  createdExchangeRates         ExchangeRate[]
  refreshToken                 String?                  @map("refresh_token") @db.Text
  refreshTokenExpiry           DateTime?                @map("refresh_token_expiry") @db.Timestamptz(6)
  auditLogs                    AuditLog[]

  @@index([marketId])
  @@index([customRoleId])
  @@map("users")
}
