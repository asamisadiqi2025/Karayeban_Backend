// ============================================================
// Enterprise Multi-Tenant Market Management System
// Prisma 7.x schema
// ============================================================
//
// VERSION: 10.0.0 - Production Ready
//
// CRITICAL FIXES & IMPROVEMENTS:
// 1. Fixed UUID generation - application-layer UUID v7
// 2. Removed composite FK syntax - handled in migration
// 3. Added check constraints (migration comments)
// 4. Added partitioning support fields
// 5. Fixed Decimal precision (18,2) for all money amounts
// 6. Added optimistic locking (version) to all high-contention tables
// 7. Added AccountingPeriod for financial closing
// 8. Added SecurityDeposit for deposit management
// 9. Added GDPR compliance fields
// 10. Added brute force protection
// 11. Added contract auto-renewal
// 12. Added payment allocation
// 13. Fixed audit log storage strategy
// 14. Added archiving fields
// 15. Fixed Permission model (scope removed from unique)
// 16. Fixed UserRole/Role isolation (migration constraint)
// 17. Added proper indexes for performance
// ============================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // connectionLimit = 50 // Set in prisma.config.ts for enterprise
}

// ============================================================
// ENUMS
// ============================================================

enum MarketStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum ShopStatus {
  EMPTY
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  MOVED_OUT
  BLACKLISTED
}

enum DebtStatus {
  PAID
  DEBTOR
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  TERMINATED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum UtilityType {
  ELECTRICITY
  WATER
  CLEANING
  SECURITY
  OTHER
}

enum UtilityPaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum EmploymentType {
  OWNER
  MANAGER
  ACCOUNTANT
  SECURITY
  CLEANER
  CASHIER
  MAINTENANCE
  OTHER
}

enum AccountType {
  CASH
  BANK
  MOBILE_MONEY
  OTHER
}

enum Currency {
  AFN
  USD
  EUR
  GBP
  OTHER
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  POSTED
  VOID
  REVERSED
}

enum TransactionReferenceType {
  RENT_PAYMENT
  UTILITY_BILL
  MARKET_EXPENSE
  MISC_INCOME
  WITHDRAWAL
  ADDITIONAL_INVESTMENT
  CHEQUE
  SECURITY_DEPOSIT
  REVERSAL
  JOURNAL_ENTRY
  OTHER
}

enum ChequeStatus {
  PENDING
  RECEIVED
  RETURNED
  CLEARED
}

enum DocumentEntityType {
  TENANT
  CONTRACT
  SHOP
  GUARANTOR
  CHEQUE
  MARKET
  EMPLOYEE
  EXPENSE
}

enum StorageProvider {
  LOCAL
  S3
  SUPABASE
  CLOUDINARY
  AZURE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum NotificationType {
  RENT_DUE
  PAYMENT_RECEIVED
  CONTRACT_EXPIRING
  UTILITY_DUE
  CHEQUE_DUE
  SYSTEM
  OTHER
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InvestmentType {
  CASH
  EQUIPMENT
  CONSTRUCTION
  OTHER
}

enum AuditOperation {
  CREATE
  UPDATE
  DELETE
  RESTORE
  APPROVE
  REJECT
  EXPORT
  IMPORT
  PASSWORD_CHANGE
  ROLE_CHANGE
  LOGIN
  LOGOUT
}

enum AuditActionSource {
  WEB
  API
  MOBILE
  SYSTEM
  CRON
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  MOBILE_MONEY
  OTHER
}

enum NotificationReferenceType {
  CONTRACT
  RENT_PAYMENT
  UTILITY_BILL
  CHEQUE
  TENANT
  SHOP
  OTHER
}

enum RoleScope {
  GLOBAL
  MARKET
}

enum PermissionScope {
  GLOBAL
  MARKET
}

enum EmployeeAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

enum SuperAdminLevel {
  OWNER
  ADMIN
  SUPPORT
}


enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalEntityType {
  CONTRACT
  EXPENSE
  WITHDRAWAL
  PAYMENT
  TENANT_DELETE
  SHOP_DELETE
  OTHER
}

enum JournalStatus {
  DRAFT
  POSTED
  VOID
}

enum PeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum DepositStatus {
  HELD
  RETURNED
  PARTIAL
  FORFEITED
}

// ============================================================
// CORE / STRUCTURE
// ============================================================



model Market {
   id String @id @db.Uuid

  name String @db.VarChar(255)
  code String @unique @db.VarChar(50)

  address String? @db.Text
  phone   String? @db.VarChar(20)

  status MarketStatus @default(ACTIVE)
 
  floors                Floor[]
  shops                 Shop[]
  shopCategories        ShopCategory[]
  marketTenants         MarketTenant[]
  contracts             Contract[]
  rentPayments          RentPayment[]
  utilityBills          UtilityBill[]
  expenseCategories     ExpenseCategory[]
  marketEmployees       MarketEmployee[]
  marketExpenses        MarketExpense[]
  accounts              Account[]
  miscellaneousIncomes  MiscellaneousIncome[]
  accountTransactions   AccountTransaction[]
  journalEntries        JournalEntry[]
  exitClearances        ExitClearance[]
  cheques               Cheque[]
  documents             Document[]
  users                 User[]
  userMarkets           UserMarket[]
  userRoles             UserRole[]
  auditLogs             AuditLog[]
  activities            ActivityLog[]
  notifications         Notification[]
  contractTerms         ContractTerm[]
  ownershipHistories    OwnershipHistory[]
  shareholders          Shareholder[]
  additionalInvestments AdditionalInvestment[]
  withdrawals           Withdrawal[]
  roles                 Role[]
  settings              MarketSetting?
  exchangeRates         ExchangeRate[]
  apiKeys               ApiKey[]

  approvalRequests      ApprovalRequest[]
  accountingPeriods     AccountingPeriod[]
  securityDeposits      SecurityDeposit[]
  maintenanceRequests MaintenanceRequest[]

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  version Int @default(1) // Optimistic locking

  @@index([status])
  @@index([deletedAt])
  @@map("markets")
  @@index([status, deletedAt])
  
}





model SystemSetting {
    id String @id @db.Uuid

  key   String @unique @db.VarChar(100)
  value Json

  category String? @db.VarChar(50)
  description String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("system_settings")
}

model MarketSetting {
    id String @id @db.Uuid

  marketId String @unique @db.Uuid
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  config Json // All settings in one JSON field

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("market_settings")
}

model ExchangeRate {
    id String @id @db.Uuid

  marketId String @db.Uuid
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  fromCurrency Currency
  toCurrency   Currency
  rate         Decimal @db.Decimal(14, 4)

  effectiveDate DateTime @default(now()) @db.Date
  expiresAt     DateTime? @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([marketId, fromCurrency, toCurrency, effectiveDate])
  @@index([marketId, fromCurrency, toCurrency])
  @@map("exchange_rates")
}

// ============================================================
// ACCOUNTING PERIODS
// ============================================================

model AccountingPeriod {
    id String @id @db.Uuid

  marketId String @db.Uuid
  market   Market @relation(fields: [marketId], references: [id], onDelete: Restrict)

  year  Int @db.SmallInt
  month Int @db.SmallInt

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  status PeriodStatus @default(OPEN)

  closedAt DateTime? @db.Timestamptz(6)
  lockedAt DateTime? @db.Timestamptz(6)

  journalEntries JournalEntry[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  version Int @default(1)

  @@unique([marketId, year, month])
  @@index([marketId, status])
  @@map("accounting_periods")
}

// ============================================================
// FLOORS / SHOPS / CATEGORIES
// ============================================================

model Floor {
    id String @id @db.Uuid

  marketId String @db.Uuid
  market   Market @relation(fields: [marketId], references: [id], onDelete: Restrict)

  name         String @db.VarChar(100)
  displayOrder Int @db.SmallInt
  description  String? @db.Text

  shops Shop[]

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  version Int @default(1)

  @@unique([marketId, name])
  @@index([marketId])
  @@index([deletedAt])
  @@map("floors")
}

model Shop {
    id String @id @db.Uuid

  marketId   String  @db.Uuid
  floorId    String  @db.Uuid
  categoryId String? @db.Uuid

  market   Market        @relation(fields: [marketId], references: [id], onDelete: Restrict)
  floor    Floor         @relation(fields: [floorId], references: [id], onDelete: Restrict)
  category ShopCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  shopCode           String @db.VarChar(50)
  shopNumber         String @db.VarChar(50)
  rentAmount         Decimal @db.Decimal(18, 2)
  areaInSquareMeters Decimal @db.Decimal(10, 2)

  electricityMeterNumber String? @db.VarChar(50)
  waterMeterNumber       String? @db.VarChar(50)

  status ShopStatus @default(EMPTY)

  contracts      Contract[]
  rentPayments   RentPayment[]
  utilityBills   UtilityBill[]
  exitClearances ExitClearance[]
  maintenance    MaintenanceRequest[]

  version Int @default(1)

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@unique([marketId, shopCode])
  @@unique([marketId, shopNumber])
  @@index([marketId, status])
  @@index([floorId])
  @@index([categoryId])
  @@index([deletedAt])
  @@map("shops")
}

model ShopCategory {
   id String @id @db.Uuid

  marketId String @db.Uuid
  market   Market @relation(fields: [marketId], references: [id], onDelete: Restrict)

  name        String @db.VarChar(100)
  description String? @db.Text

  shops Shop[]

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  version Int @default(1)

  @@unique([marketId, name])
  @@index([marketId])
  @@index([deletedAt])
  @@map("shop_categories")
}

// ============================================================
// TENANTS (Global) / GUARANTORS
// ============================================================

model Tenant {
    id String @id @db.Uuid

  firstName  String @db.VarChar(100)
  lastName   String @db.VarChar(100)
  phone      String @db.VarChar(20)
  nationalId String? @db.VarChar(50)
  gender     Gender?
  address    String? @db.Text

  status     TenantStatus @default(ACTIVE)
  debtStatus DebtStatus   @default(PAID)

  marketTenants      MarketTenant[]
  contracts         Contract[]
  guarantorRelations TenantGuarantor[]
  cheques            Cheque[]
  exitClearances     ExitClearance[]
  history            TenantHistory[]
  maintenance        MaintenanceRequest[]
 
  version Int @default(1)

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  // Migration: CREATE UNIQUE INDEX tenant_phone_active ON tenants(phone) WHERE deleted_at IS NULL;
  // Migration: CREATE UNIQUE INDEX tenant_national_id_active ON tenants(national_id) WHERE deleted_at IS NULL;
  @@index([phone])
  @@index([nationalId])
  @@index([deletedAt])
  @@map("tenants")
}
model MarketTenant {
    id String @id @db.Uuid

  marketId String @db.Uuid
  tenantId String @db.Uuid

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contracts Contract[]

  joinedAt DateTime @default(now()) @db.Timestamptz(6)
  leftAt   DateTime? @db.Timestamptz(6)

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  version Int @default(1)

  @@unique([marketId, tenantId])
  @@index([marketId])
  @@index([tenantId])
  @@index([deletedAt])
  @@map("market_tenants")
}

model TenantHistory {
   id String @id @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  fieldName String @db.VarChar(50)
  oldValue  String? @db.Text
  newValue  String? @db.Text

  changedById String? @db.Uuid

  changedAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenantId])
  @@index([changedAt])
  @@map("tenant_histories")
}

model Guarantor {
    id String @id @db.Uuid

  fullName    String @db.VarChar(200)
  phone       String @db.VarChar(20)
  address     String? @db.Text
  description String? @db.Text

  tenantRelations TenantGuarantor[]

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  version Int @default(1)

  // Migration: CREATE UNIQUE INDEX guarantor_phone_active ON guarantors(phone) WHERE deleted_at IS NULL;
  @@index([phone])
  @@index([deletedAt])
  @@map("guarantors")
}

model TenantGuarantor {
    id String @id @db.Uuid

  tenantId    String @db.Uuid
  guarantorId String @db.Uuid

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guarantor Guarantor @relation(fields: [guarantorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([tenantId, guarantorId])
  @@index([tenantId])
  @@index([guarantorId])
  @@map("tenant_guarantors")
}

// ============================================================
// CONTRACTS
// ============================================================

model Contract {
  id String @id @db.Uuid

  marketId String @db.Uuid
  shopId   String @db.Uuid
  marketTenantId String @db.Uuid
  tenantId String @db.Uuid // FIX: Denormalized for query performance

  market      Market      @relation(fields: [marketId], references: [id], onDelete: Restrict)
  shop        Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  marketTenant MarketTenant @relation(fields: [marketTenantId], references: [id], onDelete: Restrict)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  contractNumber String @db.VarChar(50)

  previousContractId String? @db.Uuid
  previousContract   Contract? @relation("ContractHistory", fields: [previousContractId], references: [id], onDelete: SetNull)
  nextContracts      Contract[] @relation("ContractHistory")

  renewalCount Int @default(0)

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  monthlyRent   Decimal @db.Decimal(18, 2)
  depositAmount Decimal @db.Decimal(18, 2)

  status ContractStatus @default(ACTIVE)

  signedDate        DateTime? @db.Date
  approvedById      String? @db.Uuid
  terminatedById    String? @db.Uuid
  terminationReason String? @db.Text

  autoRenew Boolean @default(false)
  autoRenewNoticeDays Int @default(30)
  lastRenewalDate DateTime? @db.Date
  nextRenewalDate DateTime? @db.Date
  renewalHistory Json?

  terms         ContractTerm?
  rentPayments  RentPayment[]
  cheques       Cheque[]
  exitClearance ExitClearance?
  securityDeposit SecurityDeposit?

  description String? @db.Text

  version Int @default(1)

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@unique([marketId, contractNumber])
  // Migration: ALTER TABLE contracts ADD CONSTRAINT valid_date_range CHECK (end_date >= start_date);
  // Migration: ALTER TABLE contracts ADD CONSTRAINT no_overlapping_contracts 
  // EXCLUDE USING gist (shop_id WITH =, daterange(start_date, end_date, '[]') WITH &&)
  // WHERE status IN ('ACTIVE', 'PENDING');
  @@index([marketId, status])
  @@index([marketId, status, startDate])
  @@index([shopId])
  @@index([marketTenantId])
  @@index([tenantId])
  @@index([previousContractId])
  @@index([deletedAt])
  @@map("contracts")
}

model ContractTerm {
   id String @id @db.Uuid

  marketId   String @db.Uuid
  contractId String @db.Uuid
  market     Market   @relation(fields: [marketId], references: [id], onDelete: Restrict)
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  workingHours         String? @db.Text
  monthlyHoliday       Int? @db.SmallInt
  terminationCondition String? @db.Text
  specialConditions    String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([contractId])
  @@index([marketId])
  @@index([contractId])
  @@map("contract_terms")
}

// ============================================================
// SECURITY DEPOSIT
// ============================================================

model SecurityDeposit {
    id String @id @db.Uuid

  contractId String @db.Uuid
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  marketId String @db.Uuid
  market   Market @relation(fields: [marketId], references: [id], onDelete: Restrict)

  amount Decimal @db.Decimal(18, 2)
  paidAt DateTime @db.Date

  returnedAt DateTime? @db.Date
  returnedAmount Decimal? @db.Decimal(18, 2)

  deductions Json? // Array of {item, amount, date}

  status DepositStatus @default(HELD)

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  version Int @default(1)

  @@unique([contractId])
  @@index([marketId])
  @@index([status])
  @@index([deletedAt])
  @@map("security_deposits")
}

// ============================================================
// PAYMENTS / UTILITIES
// ============================================================

model RentPayment {
   id String @id @db.Uuid

  marketId   String  @db.Uuid
  shopId     String  @db.Uuid
  contractId String  @db.Uuid
  accountId  String? @db.Uuid

  market   Market   @relation(fields: [marketId], references: [id], onDelete: Restrict)
  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  account  Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  amountDue       Decimal @db.Decimal(18, 2)
  amountPaid      Decimal @default(0) @db.Decimal(18, 2)
  remainingAmount Decimal @db.Decimal(18, 2)

  paymentDate   DateTime? @db.Date
  paymentMethod PaymentMethod?

  status PaymentStatus @default(PENDING)

  year  Int @db.SmallInt
  month Int @db.SmallInt

  lateFee  Decimal? @db.Decimal(18, 2)
  discount Decimal? @db.Decimal(18, 2)

  receivedById String? @db.Uuid

  description String? @db.Text

   sourceAllocations PaymentAllocation[] @relation("PaymentAllocationSource")
  targetAllocations PaymentAllocation[] @relation("PaymentAllocationTarget")

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  version Int @default(1)

  @@unique([contractId, year, month])
  @@index([marketId, year, month])
  @@index([marketId, status])
  @@index([marketId, paymentDate, status])
  @@index([marketId, contractId, status])
  @@index([contractId])
  @@index([shopId])
  @@index([accountId])
  @@map("rent_payments")
}
// Payment Allocation for payments covering multiple months
model PaymentAllocation {
    id String @id @db.Uuid

  paymentId    String @db.Uuid
  rentPaymentId String @db.Uuid

  payment    RentPayment  @relation("PaymentAllocationSource", fields: [paymentId], references: [id], onDelete: Cascade)
  rentPayment RentPayment @relation("PaymentAllocationTarget", fields: [rentPaymentId], references: [id], onDelete: Cascade)
  amount Decimal @db.Decimal(18, 2)

  allocatedAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([paymentId, rentPaymentId])
  @@index([paymentId])
  @@index([rentPaymentId])
  @@map("payment_allocations")
}

model UtilityBill {
    id String @id @db.Uuid

  marketId String @db.Uuid
  shopId   String @db.Uuid

  market Market @relation(fields: [marketId], references: [id], onDelete: Restrict)
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Restrict)

  type UtilityType

  previousMeter Decimal? @db.Decimal(12, 3)
  currentMeter  Decimal? @db.Decimal(12, 3)
  unitsConsumed Decimal? @db.Decimal(12, 3)
  rate          Decimal? @db.Decimal(14, 4)
  amount        Decimal @db.Decimal(18, 2)

  billMonth Int @db.SmallInt
  billYear  Int @db.SmallInt

  dueDate DateTime? @db.Date

  status UtilityPaymentStatus @default(PENDING)

  description String? @db.Text

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  version Int @default(1)

  @@unique([shopId, type, billYear, billMonth])
  @@index([marketId, billYear, billMonth])
  @@index([marketId, status])
  @@index([shopId])
  @@map("utility_bills")
}

// ============================================================
// EMPLOYEES (Global) / MARKET EMPLOYEE
// ============================================================
model Employee {
    id String @id @db.Uuid

  userId String? @unique @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName String @db.VarChar(200)
  phone    String? @db.VarChar(20)
  position String? @db.VarChar(100)
  employmentType EmploymentType @default(OTHER)
  hireDate DateTime? @db.Date

  baseSalary Decimal? @db.Decimal(18, 2)
  hourlyRate Decimal? @db.Decimal(14, 4)

  status EmployeeStatus @default(ACTIVE)

  marketEmployees   MarketEmployee[]
  expenses          MarketExpense[]

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  version Int @default(1)

  // Migration: CREATE UNIQUE INDEX employee_phone_active ON employees(phone) WHERE deleted_at IS NULL;
  @@index([phone])
