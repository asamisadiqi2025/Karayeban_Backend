generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CASH
  BANK
}

model Account {
  id         String @id @default(uuid()) @db.Uuid
  marketId   String @map("market_id") @db.Uuid
  currencyId String @map("currency_id") @db.Uuid

  name String
  type AccountType

  accountNumber String? @map("account_number")
  bankName      String? @map("bank_name")

  balance Decimal @default(0) @db.Decimal(18, 4)

  isActive Boolean @default(true) @map("is_active")
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  market   Market   @relation(fields: [marketId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])

  openingBalances OpeningBalance[]

  expenses                Expense[]
  rentPayments            RentPayment[]
  rentCharges             RentCharges[]
  miscellaneousIncome     MiscellaneousIncome[]
  electricityPayments     ElectricityPayment[]
  shareholderTransactions ShareholderTransaction[]
  collateralItems         CollateralItem[]

  transfersOut AccountTransfer[] @relation("TransferFrom")
  transfersIn  AccountTransfer[] @relation("TransferTo")

  @@unique([marketId, name])
  @@index([marketId])
  @@index([currencyId])
  @@map("accounts")
}

// انتقال پول بین دو «بانک/دخل» داخلی (مثلاً صرافی حاجی داود ← دخل مارکت).
// فقط بین دو Account با ارز یکسان مجاز است (هم‌جنس)؛ این قید در سطح سرویس اعمال می‌شود
// چون Prisma/Postgres راهی برای مقایسهٔ currencyId دو ردیف مرتبط در سطح schema ندارد.
model AccountTransfer {
  id            String @id @default(uuid()) @db.Uuid
  marketId      String @map("market_id") @db.Uuid
  fromAccountId String @map("from_account_id") @db.Uuid
  toAccountId   String @map("to_account_id") @db.Uuid

  amount       Decimal  @db.Decimal(18, 4)
  transferDate DateTime @map("transfer_date") @db.Timestamptz(6)
  notes        String?  @db.Text

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  market      Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  fromAccount Account @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   Account @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  createdBy   User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([marketId])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("account_transfers")
}


model Asset {
  id                 String      @id @default(uuid()) @db.Uuid
  marketId           String      @map("market_id") @db.Uuid
  name               String      @db.VarChar(150)
  category           String?     @db.VarChar(100)
  purchasePrice      Decimal     @map("purchase_price") @db.Decimal(12, 2)
  currencyId         String      @map("currency_id") @db.Uuid
  lifespanYears      Int         @map("lifespan_years")
  annualDepreciation Decimal     @map("annual_depreciation") @db.Decimal(12, 2)
  currentBookValue   Decimal     @map("current_book_value") @db.Decimal(12, 2)
  purchaseDate       DateTime    @map("purchase_date")
  status             AssetStatus @default(active)
  details            String?     @db.Text
  isDeleted          Boolean     @default(false) @map("is_deleted")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  market             Market              @relation(fields: [marketId], references: [id], onDelete: Cascade)
  currency           Currency            @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  depreciationEvents DepreciationEvent[]

  @@map("assets")
}


model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  marketId   String      @map("market_id") @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(100)
  entityId   String      @map("entity_id") @db.Uuid
  oldData    Json?       @map("old_data")
  newData    Json?       @map("new_data")
  ipAddress  String?     @map("ip_address") @db.Inet
  userAgent  String?     @map("user_agent") @db.Text
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([marketId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}


// auth.prisma
// This file is intentionally left empty to avoid duplicating the User model.
// The actual User model now lives in user.prisma.


// ============================
// گدام — اجناسی که مستاجر به‌جای پول نقد به‌عنوان وثیقهٔ بدهی می‌گذارد.
// اگر بدهی تسویه نشود، جنس فروخته می‌شود (status=SOLD) و مبلغ فروش صرف بدهی می‌شود.
// ============================

enum CollateralStatus {
  HELD // در گدام است
  RETURNED // بدون فروش به مستاجر پس داده شد
  SOLD // برای پوشش بدهی فروخته شد
}

model CollateralItem {
  id         String  @id @default(uuid()) @db.Uuid
  marketId   String  @map("market_id") @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  contractId String? @map("contract_id") @db.Uuid

  description    String           @db.Text
  estimatedValue Decimal          @map("estimated_value") @db.Decimal(15, 2)
  currency       String           @default("AFN") @db.VarChar(10)
  receivedDate   DateTime         @map("received_date") @db.Timestamptz(6)
  status         CollateralStatus @default(HELD)

  returnedDate DateTime? @map("returned_date") @db.Timestamptz(6)

  // جزئیات فروش — وقتی دوکاندار بدهی خود را نیاورد و جنسش فروخته می‌شود
  soldDate            DateTime? @map("sold_date") @db.Timestamptz(6)
  soldAmount          Decimal?  @map("sold_amount") @db.Decimal(15, 2)
  soldToDescription   String?   @map("sold_to_description") @db.Text
  appliedToDebtAmount Decimal?  @map("applied_to_debt_amount") @db.Decimal(15, 2)
  accountId           String?   @map("account_id") @db.Uuid
  settlementId        String?   @map("settlement_id") @db.Uuid

  notes       String?  @db.Text
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  market     Market              @relation(fields: [marketId], references: [id], onDelete: Cascade)
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contract   Contract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  account    Account?            @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy  User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  settlement ContractSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([marketId])
  @@index([tenantId])
  @@index([status])
  @@map("collateral_items")
}


enum SettlementMethod {
  CASH
  COLLATERAL
  WRITE_OFF
  MIXED
}

// تسویهٔ نهایی هنگام خروج مستاجر/پایان قرارداد — رکورد ساختاریافتهٔ اینکه بدهی چگونه صفر شد
// (نقد، از محل وثیقهٔ جنسی، بخشیده‌شده، یا ترکیبی)، به‌جای یک متن آزاد در ContractStatusHistory.reason.
model ContractSettlement {
  id         String @id @default(uuid()) @db.Uuid
  contractId String @unique @map("contract_id") @db.Uuid

  finalRentDebt        Decimal          @map("final_rent_debt") @db.Decimal(18, 2)
  finalElectricityDebt Decimal          @map("final_electricity_debt") @db.Decimal(15, 2)
  settlementMethod     SettlementMethod @map("settlement_method")
  settledAmount        Decimal          @map("settled_amount") @db.Decimal(18, 2)
  currency             String           @default("AFN") @db.VarChar(10)

  notes        String?  @db.Text
  approvedById String?  @map("approved_by_id") @db.Uuid
  settledAt    DateTime @map("settled_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  approvedBy User?    @relation(fields: [approvedById], references: [id], onDelete: SetNull)

  // اجناس وثیقه‌ای که برای پوشش بدهی در همین تسویه فروخته/برگردانده شدند.
  collateralItems CollateralItem[]

  @@map("contract_settlements")
}


model ContractStatusHistory {
  id          String          @id @default(uuid()) @db.Uuid
  contractId  String          @map("contract_id") @db.Uuid
  fromStatus  ContractStatus? @map("from_status")
  toStatus    ContractStatus  @map("to_status")
  changedAt   DateTime        @default(now()) @map("changed_at") @db.Timestamptz(6)
  changedById String?         @map("changed_by_id") @db.Uuid
  reason      String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  contract  Contract @relation("ContractStatusHistory", fields: [contractId], references: [id], onDelete: Cascade)
  changedBy User?    @relation("ContractStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([contractId])
  @@map("contract_status_history")
}


model Contract {
  id       String  @id @default(uuid()) @db.Uuid
  marketId String  @map("market_id") @db.Uuid
  // برای دوکان‌های ادغام‌شده، shopId به دوکانِ اصلی/فاکتورشونده اشاره می‌کند؛
  // فهرست کامل همهٔ دوکان‌های تحت این قرارداد از رابطهٔ contractShops به‌دست می‌آید.
  // نکته: هیچ قید دیتابیسی جلوی دو قرارداد status=active هم‌زمان روی یک shopId را نمی‌گیرد؛
  // باید با یک migration دستی (CREATE UNIQUE INDEX ... WHERE status = 'active') و/یا چک تراکنشی در سرویس تضمین شود.
  shopId   String? @map("shop_id") @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid

  startDate DateTime?      @map("start_date")
  endDate   DateTime?      @map("end_date")
  status    ContractStatus @default(draft)
  rent      Decimal?       @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  market Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  shop   Shop?   @relation("ContractPrimaryShop", fields: [shopId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  rentCharges    RentCharges[]
  rentPayments   RentPayment[]
  statusHistory  ContractStatusHistory[] @relation("ContractStatusHistory")
  terminatedById String?                 @map("terminated_by_id") @db.Uuid
  terminatedBy   User?                   @relation("ContractTerminatedBy", fields: [terminatedById], references: [id], onDelete: SetNull)

  currentShop Shop? @relation("CurrentShopContract")

  // همهٔ دوکان‌های تحت پوشش این قرارداد (برای قرارداد ساده یک ردیف، برای دوکان‌های ادغام‌شده چند ردیف).
  contractShops   ContractShop[]
  // دورهٔ ادغامی که این قرارداد میزبان آن بوده (برای همبستگی با کنتور برق مشترک).
  shopGroups      ShopGroup[]
  collateralItems CollateralItem[]

  // اگر این قرارداد از تمدید یک قرارداد قبلی ساخته شده، زنجیرهٔ تمدید قابل‌بازسازی است.
  renewedFromContractId String?   @unique @map("renewed_from_contract_id") @db.Uuid
  renewedFromContract   Contract? @relation("ContractRenewal", fields: [renewedFromContractId], references: [id], onDelete: SetNull)
  renewedToContract     Contract? @relation("ContractRenewal")

  settlement ContractSettlement?

  @@index([marketId])
  @@index([shopId])
  @@index([tenantId])
  @@map("contracts")
}

// پیوند چندبه‌چند بین قرارداد و دوکان — برای زمانی که چند دوکانِ ادغام‌شده زیر یک قرارداد واحد می‌روند.
model ContractShop {
  id         String    @id @default(uuid()) @db.Uuid
  contractId String    @map("contract_id") @db.Uuid
  shopId     String    @map("shop_id") @db.Uuid
  isPrimary  Boolean   @default(false) @map("is_primary")
  joinedAt   DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt     DateTime? @map("left_at") @db.Timestamptz(6)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@unique([contractId, shopId])
  @@index([contractId])
  @@index([shopId])
  @@map("contract_shops")
}


model Currency {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(3)
  name            String?
  accounts        Account[]
  openingBalances OpeningBalance[]

  markets             Market[]
  exchangeRates       ExchangeRate[]
  expenses            Expense[]
  rentPayments        RentPayment[]
  rentCharges         RentCharges[]
  assets              Asset[]
  miscellaneousIncome MiscellaneousIncome[]
}


model CustomRole {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  marketId    String   @map("market_id") @db.Uuid
  permissions String[]
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([marketId, name])
  @@index([marketId])
  @@map("custom_roles")
}


// electricity.prisma
// Existing TypeORM files: src/modules/electricity/entities/*.ts
