# Database — Coolify injects DATABASE_URL when you link a Postgres resource
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/karayeban

# App
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=3600s
JWT_REFRESH_EXPIRES_IN=604800

# Swagger / OpenAPI docs
# Defaults: enabled when NODE_ENV != production. Set explicitly to override.
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_TITLE=Karayeban Backend API
SWAGGER_DESCRIPTION=REST API documentation for Karayeban Backend
SWAGGER_VERSION=1.0
# Set both to gate the docs UI + spec behind HTTP Basic Auth (recommended on prod)
SWAGGER_USER=
SWAGGER_PASSWORD=
