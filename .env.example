# Database — Coolify injects DATABASE_URL when you link a Postgres resource
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/karayeban

# App
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=3600s
JWT_REFRESH_EXPIRES_IN=604800

# Swagger / OpenAPI docs
# Defaults: enabled when NODE_ENV != production. Set explicitly to override.
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_TITLE=Karayeban Backend API
SWAGGER_DESCRIPTION=REST API documentation for Karayeban Backend
SWAGGER_VERSION=1.0
# Set both to gate the docs UI + spec behind HTTP Basic Auth (recommended on prod)
SWAGGER_USER=
SWAGGER_PASSWORD=

# Password reset by email (ADMIN / SUPER_ADMIN only)
# Works with any SMTP provider (Gmail App Password, Brevo, Resend SMTP, ...).
# If MAIL_HOST is empty: in development the email text (with the link) is printed to the
# server log; in production nothing is sent and a warning is logged.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=shahinriaz2004@gmail.com
MAIL_PASS=vttu hmyy sesc gjkj
MAIL_FROM=
# Frontend page that receives ?token=... (the link in the email points here)
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Per-market backups (daily automatic + manual, restored only by operators)
# BACKUP_DIR must be a PERSISTENT volume in production (Coolify -> Persistent Storage -> /app/backups).
BACKUP_DIR=backups
# Daily automatic backup time for ALL markets (Kabul time, HH:mm, 24h). Markets can only switch it on/off.
BACKUP_TIME=02:30
BACKUP_AUTO_RETENTION_DAYS=7
BACKUP_MANUAL_RETENTION_DAYS=30
